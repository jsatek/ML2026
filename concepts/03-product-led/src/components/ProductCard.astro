---
import { getCategory, getMaterial } from '@ml/content';
import Media from './Media.astro';
import SampleButton from './SampleButton.astro';
import { url } from '../lib/utils';
import { COLOR_FAMILIES } from '../lib/colors';
import { records, finishByFamily } from '../lib/records';

interface Props { product: any; compare?: boolean; eager?: boolean; }
const { product: p, compare = false, eager = false } = Astro.props;
const rec = records.find((r) => r.slug === p.slug)!;
const fams = COLOR_FAMILIES.filter((f) => rec.colors.includes(f.slug));
---
<article class="card group flex flex-col overflow-hidden transition hover:shadow-lg" data-card={p.slug} data-finishes={JSON.stringify(finishByFamily[p.slug])}>
  <a href={url(`/products/${p.slug}`)} class="relative block" tabindex="-1" aria-hidden="true">
    <Media src={p.images.hero} class="aspect-[4/3]" eager={eager} />
    <span class="absolute left-2 top-2 rounded-md bg-white/90 px-2 py-0.5 text-xs font-semibold">{getMaterial(p.material)?.name}</span>
  </a>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="text-lg leading-tight"><a href={url(`/products/${p.slug}`)} class="hover:underline">{p.name}</a></h3>
    <p class="text-sm text-muted">{p.types.map((t: string) => getCategory(t)?.name).join(' · ')}</p>
    <div class="flex flex-wrap gap-1.5 text-xs">
      <span class:list={['rounded-md px-2 py-0.5 font-semibold', p.attributes.nrc != null ? 'bg-sky/40 text-green' : 'bg-panel text-muted']}>NRC {p.attributes.nrc != null ? p.attributes.nrc.toFixed(2) : 'n/a'}</span>
      {p.attributes.fireRating && <span class="rounded-md bg-panel px-2 py-0.5 font-semibold">Class {p.attributes.fireRating}</span>}
      <span class="rounded-md bg-panel px-2 py-0.5">{p.finishes.length} finishes</span>
    </div>
    <div class="flex gap-1" aria-label="Color families">{fams.map((f) => <span class="size-3 rounded-full ring-1 ring-black/10" style={`background:${f.hex}`} title={f.name}></span>)}</div>
    <div class="mt-auto flex items-center justify-between gap-2 pt-2">
      {compare ? <label class="flex items-center gap-1.5 text-sm text-muted"><input type="checkbox" class="size-4 accent-(--ml-deep-green)" data-compare value={p.slug} /> Compare</label> : <span />}
      {p.finishes[0] && <SampleButton product={p.slug} name={p.name} finish={p.finishes[0].name} label={`Sample · ${p.finishes[0].name}`} />}
    </div>
  </div>
</article>
