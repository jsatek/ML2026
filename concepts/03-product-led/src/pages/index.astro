---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Media from '../components/Media.astro';
import { site, products, categories, materials, projects, resources, productsInMaterial, getMaterial, specSummary, formatNrc } from '@ml/content';
import { records, usedFamilies } from '../lib/records';
import { url } from '../lib/utils';

const surfaces = [...new Set(categories.map((c) => c.group))];
const ordered = [...products].sort((a, b) => Number(b.featured) - Number(a.featured));
const feature = projects.find((p) => !p.placeholder)!;
const materialList = new Intl.ListFormat('en', { type: 'conjunction' }).format(materials.map((m) => m.name));
const silk = getMaterial('silk-metal')!;
const silkProducts = productsInMaterial(silk.slug);
const silkSpec = specSummary(silkProducts);
const silkSentences = silk.summary.match(/[^.!?]+[.!?]+/g) ?? [];
const silkAt = silkSentences.findIndex((t) => t.includes('perforations'));
const silkCopy = silkAt >= 0 ? silkSentences.slice(silkAt, silkAt + 2).join(' ').trim() : silk.aka;
const silkHero = silkProducts.find((p) => p.slug === 'silk-metal-grille') ?? silkProducts[0];
---
<Layout>
  <section class="border-b border-line bg-panel">
    <div class="shell grid gap-10 py-10 lg:grid-cols-12 lg:py-14">
      <div class="lg:col-span-5">
        <h1 class="text-4xl leading-tight sm:text-5xl">Find products that meet your spec.</h1>
        <p class="mt-4 text-lg text-muted">{products.length} systems in {materialList}. Narrow by surface, type, material and performance; results update as you choose.</p>
        <form class="mt-8 space-y-6" data-finder>
          <fieldset><legend class="label">1 · Surface</legend>
            <div class="mt-2 flex flex-wrap gap-2">
              <label class="chip cursor-pointer"><input type="radio" name="surface" value="" class="sr-only" checked />Any</label>
              {surfaces.map((s) => <label class="chip cursor-pointer"><input type="radio" name="surface" value={s} class="sr-only" />{s}</label>)}
            </div>
          </fieldset>
          <fieldset><legend class="label">2 · Product type</legend>
            <div class="mt-2 flex flex-wrap gap-2">
              {categories.map((c) => <label class="chip cursor-pointer" data-group={c.group}><input type="checkbox" name="types" value={c.slug} class="sr-only" />{c.name}</label>)}
            </div>
          </fieldset>
          <fieldset><legend class="label">3 · Material</legend>
            <div class="mt-2 flex flex-wrap gap-2">
              {materials.map((m) => <label class="chip cursor-pointer"><input type="checkbox" name="materials" value={m.slug} class="sr-only" />{m.name}</label>)}
            </div>
          </fieldset>
          <fieldset><legend class="label">4 · Performance</legend>
            <div class="mt-2 flex flex-wrap gap-2">
              <label class="chip cursor-pointer"><input type="checkbox" name="classA" value="1" class="sr-only" />Class A fire</label>
              <label class="chip cursor-pointer"><input type="checkbox" name="minNrc" value="0.8" class="sr-only" />NRC 0.80+</label>
              <label class="chip cursor-pointer"><input type="checkbox" name="minNrc" value="1" class="sr-only" />NRC 1.00+</label>
            </div>
          </fieldset>
          <a href={url('/products')} class="btn btn-primary w-full sm:w-auto" data-see-all>See all <span data-n>{products.length}</span> matches →</a>
        </form>
      </div>
      <div class="lg:col-span-7">
        <div class="flex items-center justify-between">
          <p class="font-semibold" aria-live="polite"><span data-n>{products.length}</span> matching products</p>
          <button type="button" class="text-sm text-green underline" data-reset>Reset</button>
        </div>
        <div class="mt-3 grid gap-4 sm:grid-cols-2" data-results>
          {ordered.map((p, i) => <div data-slot={p.slug} hidden={i >= 4}><ProductCard product={p} eager={i < 4} /></div>)}
        </div>
        <p data-none hidden class="card mt-3 p-8 text-center text-muted">No exact match. Try removing a choice, or <a href={`mailto:${site.contact.email}`} class="text-green underline">ask about a custom solution</a>.</p>
      </div>
    </div>
  </section>

  <section class="bg-ink text-white" aria-labelledby="silk-h">
    <div class="shell grid items-center gap-10 py-14 lg:grid-cols-12">
      <Media src={silkHero.images.hero} color={silkSpec.finishes[0]?.hex} class="aspect-[16/10] rounded-xl lg:col-span-6" />
      <div class="lg:col-span-6">
        <h2 id="silk-h" class="text-3xl">{silk.name} <span class="block text-lg font-normal text-sky">{silk.aka}</span></h2>
        <p class="mt-4 text-white/80">{silkCopy}</p>
        <dl class="mt-6 grid grid-cols-3 gap-2 text-center text-sm">
          <div class="rounded-lg bg-white/10 p-3"><dt class="text-xs text-white/70">NRC</dt><dd class="font-bold tabular-nums">{formatNrc(silkSpec) ?? 'n/a'}</dd></div>
          <div class="rounded-lg bg-white/10 p-3"><dt class="text-xs text-white/70">Fire</dt><dd class="font-bold">{silkSpec.fire.map((r) => `Class ${r}`).join(', ') || 'n/a'}</dd></div>
          <div class="rounded-lg bg-white/10 p-3"><dt class="text-xs text-white/70">Finishes</dt><dd class="font-bold tabular-nums">{silkSpec.finishes.length}</dd></div>
        </dl>
        <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={`${silk.name} finishes`}>
          {silkSpec.finishes.map((f) => <li class="size-6 rounded ring-1 ring-white/20" style={`background:${f.hex}`} title={f.name}><span class="sr-only">{f.name}</span></li>)}
        </ul>
        <a href={url(`/products?material=${silk.slug}`)} class="btn mt-6 bg-white text-green hover:bg-sky">Show all {silkSpec.count} {silk.name} systems</a>
      </div>
    </div>
  </section>

  <section class="shell py-14" aria-labelledby="color-h">
    <h2 id="color-h" class="text-2xl">Shop by color</h2>
    <p class="mt-1 text-muted">Every finish, grouped into color families. Pick one to see the products that come in it.</p>
    <ul class="mt-6 grid grid-cols-4 gap-3 sm:grid-cols-7 lg:grid-cols-12">
      {usedFamilies.map((f) => (
        <li><a href={url(`/products?color=${f.slug}`)} class="group block text-center">
          <span class="block aspect-square rounded-xl ring-1 ring-black/10 transition group-hover:scale-105" style={`background:${f.hex}`}></span>
          <span class="mt-2 block text-xs font-medium">{f.name}</span>
          <span class="text-xs text-muted">{records.filter((r) => r.colors.includes(f.slug)).length} products</span>
        </a></li>
      ))}
    </ul>
  </section>

  <section class="border-t border-line" aria-label="Documents and samples">
    <div class="shell grid gap-12 py-12 md:grid-cols-2">
      <div>
        <h2 class="text-2xl">Build a spec kit</h2>
        <p class="mt-1 text-muted">Data sheets, CSI specs, CAD/BIM and HPDs: {resources.length} documents, searchable by product.</p>
        <form action={url('/resources')} method="get" role="search" class="mt-5 flex gap-2">
          <label for="home-doc-q" class="sr-only">Search documents</label>
          <input id="home-doc-q" name="q" type="search" placeholder="Product or document, e.g. COFFA CAD" class="field" />
          <button class="btn btn-primary shrink-0">Search</button>
        </form>
      </div>
      <div>
        <h2 class="text-2xl">Your sample tray</h2>
        <p class="mt-1 text-muted"><span data-cart-count>0</span> of {site.sampleLimit} chosen. Add finishes from any product as you browse.</p>
        <ol class="mt-5 grid grid-cols-8 gap-2" data-tray aria-label="Sample slots">
          {Array.from({ length: site.sampleLimit }, () => <li class="aspect-square rounded-md border border-dashed border-line"><span class="sr-only">Empty</span></li>)}
        </ol>
        <a href={url('/samples')} class="mt-4 inline-block font-semibold text-green underline underline-offset-4">Review and send request</a>
      </div>
    </div>
    <p class="shell border-t border-line py-6 text-muted">
      Need something outside the standard line? <a href={url(`/projects/${feature.slug}`)} class="font-semibold text-green underline underline-offset-4">See how {feature.name} was customized</a> through {site.materialize.title}.
    </p>
  </section>

  <script type="application/json" id="records" set:html={JSON.stringify(records)}></script>
  <script>
    import * as cart from '@ml/content/cart';
    import { matches, empty, toParams } from '../lib/explorer';
    import type { Rec } from '../lib/records';
    const recs: Rec[] = JSON.parse(document.getElementById('records')!.textContent!);
    const form = document.querySelector<HTMLFormElement>('[data-finder]')!;
    const slots = new Map([...document.querySelectorAll<HTMLElement>('[data-slot]')].map((el) => [el.dataset.slot!, el]));
    const container = document.querySelector<HTMLElement>('[data-results]')!;
    const seeAll = document.querySelector<HTMLAnchorElement>('[data-see-all]')!;
    const base = seeAll.getAttribute('href')!;

    function update() {
      const d = new FormData(form);
      const s = { ...empty(), surface: String(d.get('surface') ?? ''), types: d.getAll('types') as string[], materials: d.getAll('materials') as string[], classA: d.has('classA'), minNrc: Math.max(0, ...d.getAll('minNrc').map(Number)) };
      // Hide type chips that don't belong to the chosen surface.
      form.querySelectorAll<HTMLElement>('[data-group]').forEach((c) => {
        c.hidden = !!s.surface && c.dataset.group !== s.surface;
        const box = c.querySelector('input')!;
        if (c.hidden && box.checked) { box.checked = false; s.types = s.types.filter((t) => t !== box.value); }
      });
      const hits = recs.filter((r) => matches(r, s));
      slots.forEach((el) => (el.hidden = true));
      hits.slice(0, 4).forEach((r) => { const el = slots.get(r.slug)!; el.hidden = false; container.append(el); });
      document.querySelectorAll('[data-n]').forEach((n) => (n.textContent = String(hits.length)));
      document.querySelector<HTMLElement>('[data-none]')!.hidden = hits.length > 0;
      const p = toParams(s);
      seeAll.href = `${base}${p.size ? `?${p}` : ''}`;
    }
    // Sample tray: one slot per cart item, from the shared cart.
    const tray = [...document.querySelectorAll<HTMLElement>('[data-tray] > li')];
    const names = new Map(recs.map((r) => [r.slug, r.name]));
    const fillTray = (items: { product: string; finish: string }[]) => tray.forEach((slot, i) => {
      const it = items[i];
      slot.className = it ? 'aspect-square rounded-md bg-green' : 'aspect-square rounded-md border border-dashed border-line';
      slot.title = it ? `${names.get(it.product) ?? it.product} · ${it.finish}` : '';
      slot.innerHTML = `<span class="sr-only">${it ? slot.title.replace(/</g, '&lt;') : 'Empty'}</span>`;
    });
    cart.onChange(fillTray);
    form.addEventListener('change', update);
    document.querySelector('[data-reset]')!.addEventListener('click', () => { form.reset(); update(); });
    update();
  </script>
</Layout>
