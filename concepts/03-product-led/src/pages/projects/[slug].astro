---
import Layout from '../../layouts/Layout.astro';
import Media from '../../components/Media.astro';
import ProductCard from '../../components/ProductCard.astro';
import { projects, site, getProduct, getMaterial } from '@ml/content';
import { url } from '../../lib/utils';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project: p } = Astro.props;
const used = p.products.map((s) => getProduct(s)!).filter(Boolean);
const facts = [['Market', p.sector], ['Location', p.location], ['Year', p.year], ['Material', p.materials.map((m) => getMaterial(m)?.name).join(', ')], ['Application', p.applications.join(', ')]].filter(([, v]) => v);
---
<Layout title={p.name} description={p.summary}>
  <div class="shell py-4 text-sm text-muted"><a href={url('/projects')} class="hover:underline">Projects</a> / <span class="text-ink">{p.name}</span></div>
  <section class="shell grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div>
      <Media src={p.images[0]} alt={p.name} class="aspect-[16/10] rounded-2xl" eager />
      {p.images.length > 1 && <div class="mt-3 grid grid-cols-3 gap-3">{p.images.slice(1, 4).map((src) => <Media src={src} class="aspect-[4/3] rounded-xl" />)}</div>}
    </div>
    <aside>
      {p.placeholder && <p class="mb-3 rounded-lg bg-orange/15 px-3 py-2 text-sm">Sample project: real product photo, invented case study.</p>}
      <h1 class="text-3xl">{p.name}</h1>
      <p class="mt-2 text-muted">{p.summary}</p>
      <dl class="mt-4 divide-y divide-line text-sm">{facts.map(([k, v]) => <div class="flex justify-between gap-4 py-2"><dt class="text-muted">{k}</dt><dd class="text-right font-medium">{v}</dd></div>)}</dl>
      <div class="mt-4 space-y-3 text-sm">{p.story.map((s) => <p>{s}</p>)}</div>
    </aside>
  </section>
  <section class="shell mt-12" aria-labelledby="used-h">
    {used.length ? (
      <>
        <h2 id="used-h" class="text-xl">Products in this project</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{used.map((u) => <ProductCard product={u} />)}</div>
      </>
    ) : (
      <div class="card flex flex-wrap items-center justify-between gap-4 p-6">
        <div><h2 id="used-h" class="text-xl">Custom solution</h2><p class="mt-1 max-w-2xl text-sm text-muted">{site.materialize.text}</p></div>
        <div class="flex gap-2">
          <a href={url(`/products?material=${p.materials[0]}`)} class="btn btn-ghost">Explore {getMaterial(p.materials[0])?.name}</a>
          <a href={`mailto:${site.contact.email}`} class="btn btn-primary">Start a project</a>
        </div>
      </div>
    )}
  </section>
</Layout>
