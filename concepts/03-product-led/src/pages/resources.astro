---
import Layout from '../layouts/Layout.astro';
import { products, materials, resources, resourceTypes, getProduct, productsInMaterial } from '@ml/content';

const typeName = Object.fromEntries(resourceTypes.map((t) => [t.slug, t.name]));
const rows = resources.map((r) => ({
  ...r,
  typeName: typeName[r.type],
  applies: r.products.length === 1 ? getProduct(r.products[0])!.name : `${r.products.length} products`,
}));
---
<Layout title="Documents" description="Build a spec kit from every Material Logiq document.">
  <section class="shell py-8">
    <h1 class="text-3xl">Document picker</h1>
    <p class="mt-1 text-muted">Choose products and file types, tick what you need, then copy the links or export a list. {resources.length} documents.</p>
  </section>
  <div class="shell grid grid-cols-1 gap-6 lg:grid-cols-[18rem_minmax(0,1fr)]">
    <aside class="space-y-6" aria-label="Choose documents">
      <div class="card p-4">
        <p class="label">1 · Products</p>
        <input type="search" class="field mt-2 !py-1.5 text-sm" placeholder="Filter products…" data-pfilter aria-label="Filter product list" />
        <div class="mt-3 max-h-72 space-y-3 overflow-y-auto pr-1">
          {materials.map((m) => (
            <fieldset>
              <legend class="text-xs font-semibold text-muted">{m.name}</legend>
              {productsInMaterial(m.slug).map((p) => <label class="flex items-center gap-2 py-0.5 text-sm" data-pname={p.name.toLowerCase()}><input type="checkbox" name="product" value={p.slug} class="size-4 accent-(--ml-deep-green)" />{p.name}</label>)}
            </fieldset>
          ))}
        </div>
      </div>
      <div class="card p-4">
        <p class="label">2 · File types</p>
        <div class="mt-2 space-y-1">
          {resourceTypes.map((t) => <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="type" value={t.slug} class="size-4 accent-(--ml-deep-green)" /><span class="flex-1">{t.name}</span><span class="text-muted" data-tcount={t.slug}></span></label>)}
        </div>
      </div>
    </aside>

    <section aria-labelledby="doc-h">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="doc-h" class="font-semibold" aria-live="polite"><span data-shown>{rows.length}</span> documents</h2>
        <input type="search" class="field !w-64 !py-1.5 text-sm" placeholder="Search titles…" data-q aria-label="Search document titles" />
      </div>
      <div class="card mt-3 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-panel text-xs uppercase tracking-wider text-muted">
            <tr><th class="w-10 p-3"><input type="checkbox" class="size-4 accent-(--ml-deep-green)" data-all aria-label="Select all shown" /></th><th class="p-3">Document</th><th class="hidden p-3 sm:table-cell">Type</th><th class="hidden p-3 md:table-cell">Applies to</th><th class="p-3">Format</th></tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="border-t border-line hover:bg-panel/60" data-row data-products={r.products.join('|')} data-type={r.type} data-title={r.title.toLowerCase()}>
                <td class="p-0"><label class="grid size-11 cursor-pointer place-items-center"><input type="checkbox" class="size-4 accent-(--ml-deep-green)" data-pick value={r.href} data-title={r.title} aria-label={`Select ${r.title}`} /></label></td>
                <td class="p-3"><a href={r.href} target="_blank" rel="noopener" class="font-medium hover:underline">{r.title}</a></td>
                <td class="hidden p-3 text-muted sm:table-cell">{r.typeName}</td>
                <td class="hidden p-3 text-muted md:table-cell">{r.applies}</td>
                <td class="p-3"><span class="rounded bg-sky/40 px-1.5 py-0.5 text-xs font-bold text-green">{r.format}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div data-kitbar hidden class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-white shadow-[0_-6px_20px_rgba(0,0,0,.08)]">
    <div class="shell flex flex-wrap items-center justify-between gap-3 py-3">
      <p class="text-sm"><strong data-kit-n>0</strong> files in your spec kit</p>
      <div class="flex gap-2">
        <button type="button" class="btn btn-ghost btn-sm" data-kit-clear>Clear</button>
        <button type="button" class="btn btn-ghost btn-sm" data-kit-copy>Copy links</button>
        <button type="button" class="btn btn-primary btn-sm" data-kit-csv>Export CSV</button>
      </div>
    </div>
  </div>

  <script>
    const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
    const prodBoxes = [...document.querySelectorAll<HTMLInputElement>('input[name=product]')];
    const typeBoxes = [...document.querySelectorAll<HTMLInputElement>('input[name=type]')];
    const picks = [...document.querySelectorAll<HTMLInputElement>('[data-pick]')];
    const q = document.querySelector<HTMLInputElement>('[data-q]')!;
    const params = new URLSearchParams(location.search);
    prodBoxes.forEach((b) => (b.checked = params.getAll('product').includes(b.value)));
    typeBoxes.forEach((b) => (b.checked = params.getAll('type').includes(b.value)));
    q.value = params.get('q') ?? '';

    function apply() {
      const ps = prodBoxes.filter((b) => b.checked).map((b) => b.value);
      const ts = typeBoxes.filter((b) => b.checked).map((b) => b.value);
      const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
      const prodOk = (r: HTMLElement) => !ps.length || r.dataset.products!.split('|').some((x) => ps.includes(x));
      const textOk = (r: HTMLElement) => terms.every((t) => r.dataset.title!.includes(t));
      let n = 0;
      rows.forEach((r) => { const ok = prodOk(r) && textOk(r) && (!ts.length || ts.includes(r.dataset.type!)); r.hidden = !ok; if (ok) n++; });
      typeBoxes.forEach((b) => (document.querySelector(`[data-tcount="${b.value}"]`)!.textContent = String(rows.filter((r) => prodOk(r) && textOk(r) && r.dataset.type === b.value).length)));
      document.querySelector('[data-shown]')!.textContent = String(n);
      const next = new URLSearchParams();
      ps.forEach((p) => next.append('product', p)); ts.forEach((t) => next.append('type', t)); if (q.value) next.set('q', q.value);
      history.replaceState(null, '', `${location.pathname}${next.size ? `?${next}` : ''}`);
    }
    function kit() {
      const sel = picks.filter((p) => p.checked);
      document.querySelector<HTMLElement>('[data-kitbar]')!.hidden = !sel.length;
      document.querySelector('[data-kit-n]')!.textContent = String(sel.length);
      return sel;
    }
    [...prodBoxes, ...typeBoxes].forEach((b) => b.addEventListener('change', apply));
    q.addEventListener('input', apply);
    document.querySelector<HTMLInputElement>('[data-pfilter]')!.addEventListener('input', (e) => {
      const v = (e.target as HTMLInputElement).value.toLowerCase();
      document.querySelectorAll<HTMLElement>('[data-pname]').forEach((l) => (l.hidden = !l.dataset.pname!.includes(v)));
    });
    picks.forEach((p) => p.addEventListener('change', kit));
    document.querySelector<HTMLInputElement>('[data-all]')!.addEventListener('change', (e) => {
      const on = (e.target as HTMLInputElement).checked;
      rows.filter((r) => !r.hidden).forEach((r) => (r.querySelector<HTMLInputElement>('[data-pick]')!.checked = on));
      kit();
    });
    document.querySelector('[data-kit-clear]')!.addEventListener('click', () => { picks.forEach((p) => (p.checked = false)); (document.querySelector('[data-all]') as HTMLInputElement).checked = false; kit(); });
    document.querySelector('[data-kit-copy]')!.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(kit().map((p) => `${p.dataset.title}: ${p.value}`).join('\n')); btn.textContent = 'Copied ✓'; }
      catch { btn.textContent = 'Copy failed'; }
      setTimeout(() => (btn.textContent = 'Copy links'), 2000);
    });
    document.querySelector('[data-kit-csv]')!.addEventListener('click', () => {
      const csv = 'Document,URL\n' + kit().map((p) => `"${p.dataset.title!.replace(/"/g, '""')}",${p.value}`).join('\n');
      const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(new Blob([csv], { type: 'text/csv' })), download: 'material-logiq-spec-kit.csv' });
      a.click();
      URL.revokeObjectURL(a.href);
    });
    apply();
  </script>
</Layout>
