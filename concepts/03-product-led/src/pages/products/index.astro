---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, categories, materials, getMaterial } from '@ml/content';
import { records, usedFamilies } from '../../lib/records';

const surfaces = [...new Set(categories.map((c) => c.group))];
const ordered = [...products].sort((a, b) => Number(b.featured) - Number(a.featured) || a.name.localeCompare(b.name));
const compareData = Object.fromEntries(products.map((p) => [p.slug, { name: p.name, material: getMaterial(p.material)?.name, nrc: p.attributes.nrc, fire: p.attributes.fireRating, finishes: p.finishes.length, specs: p.specs, img: p.images.hero }]));
---
<Layout title="Explore products" description="Filter every Material Logiq product by type, material, performance, and color.">
  <div class="shell grid grid-cols-1 gap-6 py-6 lg:grid-cols-[17rem_minmax(0,1fr)]">
    <!-- Facets -->
    <aside aria-label="Filters" class="lg:sticky lg:top-20 lg:h-[calc(100dvh-6rem)] lg:overflow-y-auto lg:pr-2">
      <details class="card lg:border-0" open data-facets>
        <summary class="flex cursor-pointer items-center justify-between p-4 font-semibold lg:hidden">Filters <span class="text-sm font-normal text-muted" data-active-n></span></summary>
        <form class="space-y-6 p-4 pt-0 lg:p-0" data-form>
          <div><label for="ex-q" class="label">Keyword</label><input id="ex-q" name="q" type="search" class="field mt-2" placeholder="Name, finish, material…" /></div>
          <fieldset><legend class="label">Surface</legend>
            <div class="mt-2 flex flex-wrap gap-2">
              <label class="chip cursor-pointer"><input type="radio" name="surface" value="" class="sr-only" checked />Any</label>
              {surfaces.map((s) => <label class="chip cursor-pointer"><input type="radio" name="surface" value={s} class="sr-only" />{s} <span class="text-muted" data-count={`surface:${s}`}></span></label>)}
            </div>
          </fieldset>
          <fieldset><legend class="label">Product type</legend>
            <div class="mt-2 space-y-1.5">
              {categories.map((c) => <label class="flex items-center gap-2.5 text-sm"><input type="checkbox" name="types" value={c.slug} class="size-4 accent-(--ml-deep-green)" /><span class="flex-1">{c.name}</span><span class="text-muted" data-count={`types:${c.slug}`}></span></label>)}
            </div>
          </fieldset>
          <fieldset><legend class="label">Material</legend>
            <div class="mt-2 space-y-1.5">
              {materials.map((m) => <label class="flex items-center gap-2.5 text-sm"><input type="checkbox" name="materials" value={m.slug} class="size-4 accent-(--ml-deep-green)" /><span class="flex-1">{m.name}</span><span class="text-muted" data-count={`materials:${m.slug}`}></span></label>)}
            </div>
          </fieldset>
          <fieldset><legend class="label">Performance</legend>
            <label for="ex-nrc" class="mt-3 flex justify-between text-sm"><span>Minimum NRC</span><output data-nrc-out class="font-semibold">Any</output></label>
            <input id="ex-nrc" name="minNrc" type="range" min="0" max="1.5" step="0.05" value="0" class="mt-2 w-full accent-(--ml-deep-green)" />
            <label class="mt-3 flex items-center gap-2.5 text-sm"><input type="checkbox" name="classA" class="size-4 accent-(--ml-deep-green)" /><span class="flex-1">Class A fire rated</span><span class="text-muted" data-count="classA:1"></span></label>
          </fieldset>
          <fieldset><legend class="label">Color family</legend>
            <div class="mt-2 grid grid-cols-7 gap-2">
              {usedFamilies.map((f) => (
                <label class="cursor-pointer" title={f.name}>
                  <input type="checkbox" name="colors" value={f.slug} class="peer sr-only" />
                  <span class="block aspect-square rounded-full ring-1 ring-black/15 ring-offset-2 peer-checked:ring-2 peer-checked:ring-green peer-focus-visible:outline-3 peer-focus-visible:outline-orange" style={`background:${f.hex}`}><span class="sr-only">{f.name}</span></span>
                </label>
              ))}
            </div>
          </fieldset>
        </form>
      </details>
    </aside>

    <!-- Results -->
    <section aria-labelledby="results-h">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 id="results-h" class="text-2xl" aria-live="polite"><span data-total>{products.length}</span> products</h1>
        <div class="flex items-center gap-2">
          <label class="sr-only" for="ex-sort">Sort</label>
          <select id="ex-sort" class="field !w-auto !py-1.5 text-sm" data-sort>
            <option value="featured">Featured</option><option value="nrc">Highest NRC</option><option value="az">Name A–Z</option><option value="finishes">Most finishes</option>
          </select>
          <div class="flex rounded-lg border border-line p-0.5" role="group" aria-label="View">
            <button type="button" class="rounded-md px-2 py-1 text-sm aria-pressed:bg-panel aria-pressed:font-semibold" data-view="grid" aria-pressed="true">Grid</button>
            <button type="button" class="rounded-md px-2 py-1 text-sm aria-pressed:bg-panel aria-pressed:font-semibold" data-view="list" aria-pressed="false">List</button>
          </div>
        </div>
      </div>
      <div class="mt-3 flex flex-wrap gap-2" data-chips></div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3 data-[view=list]:grid-cols-1 data-[view=list]:[&_article]:flex-row data-[view=list]:[&_article>a]:w-48 data-[view=list]:[&_article>a]:shrink-0" data-grid data-view="grid">
        {ordered.map((p, i) => <div data-slot={p.slug}><ProductCard product={p} compare eager={i < 3} /></div>)}
      </div>
      <div data-none hidden class="card mt-4 p-10 text-center"><p class="font-semibold">No products match all of these filters.</p><button type="button" class="mt-2 text-green underline" data-clear>Clear all filters</button></div>
    </section>
  </div>

  <!-- Compare tray -->
  <div data-tray hidden class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-white shadow-[0_-6px_20px_rgba(0,0,0,.08)]">
    <div class="shell flex items-center justify-between gap-3 py-3">
      <p class="text-sm"><strong data-tray-n>0</strong>/3 selected <span class="hidden text-muted sm:inline" data-tray-names></span></p>
      <div class="flex gap-2"><button type="button" class="btn btn-ghost btn-sm" data-tray-clear>Clear</button><button type="button" class="btn btn-primary btn-sm" data-tray-open>Compare</button></div>
    </div>
  </div>
  <dialog data-compare-dialog class="m-auto max-h-[85vh] w-[min(68rem,calc(100%-2rem))] rounded-2xl p-0 backdrop:bg-black/50">
    <div class="sticky top-0 flex items-center justify-between border-b border-line bg-white p-4"><h2 class="text-lg">Compare</h2><button type="button" class="rounded p-2 hover:bg-panel" data-compare-close aria-label="Close">✕</button></div>
    <div class="overflow-x-auto p-4"><table class="w-full text-left text-sm" data-compare-table></table></div>
  </dialog>

  <script type="application/json" id="records" set:html={JSON.stringify(records)}></script>
  <script type="application/json" id="compare-data" set:html={JSON.stringify(compareData)}></script>
  <script>
    import { matches, fromParams, toParams, type State, type Key } from '../../lib/explorer';
    import type { Rec } from '../../lib/records';
    const recs: Rec[] = JSON.parse(document.getElementById('records')!.textContent!);
    const form = document.querySelector<HTMLFormElement>('[data-form]')!;
    const grid = document.querySelector<HTMLElement>('[data-grid]')!;
    const slots = [...grid.children] as HTMLElement[];
    const sortEl = document.querySelector<HTMLSelectElement>('[data-sort]')!;
    const labels: Record<string, string> = {};
    form.querySelectorAll<HTMLInputElement>('input[type=checkbox], input[type=radio]').forEach((i) => (labels[`${i.name}:${i.value}`] = i.closest('label')!.textContent!.replace(/\d+$/, '').trim() || i.closest('label')!.title));

    // Restore state from URL
    const init = fromParams(new URLSearchParams(location.search));
    sortEl.value = new URLSearchParams(location.search).get('sort') ?? 'featured';
    (form.elements.namedItem('q') as HTMLInputElement).value = init.q;
    (form.elements.namedItem('minNrc') as HTMLInputElement).value = String(init.minNrc);
    (form.elements.namedItem('classA') as HTMLInputElement).checked = init.classA;
    form.querySelectorAll<HTMLInputElement>('input[name=surface]').forEach((i) => (i.checked = i.value === init.surface));
    for (const [name, vals] of [['types', init.types], ['materials', init.materials], ['colors', init.colors]] as const)
      form.querySelectorAll<HTMLInputElement>(`input[name=${name}]`).forEach((i) => (i.checked = (vals as string[]).includes(i.value)));
    if (matchMedia('(max-width: 1023px)').matches) document.querySelector('[data-facets]')!.removeAttribute('open');

    const read = (): State => {
      const d = new FormData(form);
      return { q: String(d.get('q') ?? ''), surface: String(d.get('surface') ?? ''), types: d.getAll('types') as string[], materials: d.getAll('materials') as string[], minNrc: Number(d.get('minNrc') ?? 0), classA: d.has('classA'), colors: d.getAll('colors') as string[] };
    };

    function retargetSamples(s: State) {
      // With a color family selected, each card's sample button offers a finish in that family.
      slots.forEach((slot) => {
        const card = slot.querySelector<HTMLElement>('[data-card]')!;
        const btn = card.querySelector<HTMLButtonElement>('[data-add-sample]');
        if (!btn) return;
        btn.dataset.default ??= btn.dataset.finish;
        const byFam = JSON.parse(card.dataset.finishes!);
        const fin = s.colors.map((c) => byFam[c]).find(Boolean) ?? btn.dataset.default!;
        btn.dataset.finish = fin;
        btn.dataset.labelAdd = `Sample · ${fin}`;
      });
      window.dispatchEvent(new CustomEvent('ml:cart'));
    }

    function apply() {
      const s = read();
      const byId = Object.fromEntries(recs.map((r) => [r.slug, r]));
      let n = 0;
      slots.forEach((slot) => { const ok = matches(byId[slot.dataset.slot!], s); slot.hidden = !ok; if (ok) n++; });
      // Live facet counts: how many results each option would give, holding other filters.
      document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const [key, val] = el.dataset.count!.split(':') as [Key, string];
        const trial: State = { ...s, [key]: key === 'surface' ? val : key === 'classA' ? true : [val] } as State;
        el.textContent = String(recs.filter((r) => matches(r, trial)).length);
      });
      const sorted = [...slots].sort((a, b) => {
        const [ra, rb] = [byId[a.dataset.slot!], byId[b.dataset.slot!]];
        if (sortEl.value === 'nrc') return rb.nrc - ra.nrc;
        if (sortEl.value === 'az') return ra.name.localeCompare(rb.name);
        if (sortEl.value === 'finishes') return rb.finishes - ra.finishes;
        return Number(rb.featured) - Number(ra.featured) || ra.name.localeCompare(rb.name);
      });
      grid.append(...sorted);
      document.querySelector('[data-total]')!.textContent = String(n);
      document.querySelector<HTMLElement>('[data-none]')!.hidden = n > 0;
      (document.querySelector('[data-nrc-out]') as HTMLOutputElement).value = s.minNrc ? `${s.minNrc.toFixed(2)}+` : 'Any';

      // Active filter chips
      const chips: [string, () => void][] = [];
      if (s.q) chips.push([`“${s.q}”`, () => ((form.elements.namedItem('q') as HTMLInputElement).value = '')]);
      if (s.surface) chips.push([s.surface, () => form.querySelector<HTMLInputElement>('input[name=surface][value=""]')!.click()]);
      for (const k of ['types', 'materials', 'colors'] as const) s[k].forEach((v) => chips.push([labels[`${k}:${v}`] ?? v, () => (form.querySelector<HTMLInputElement>(`input[name=${k}][value="${v}"]`)!.checked = false)]));
      if (s.minNrc) chips.push([`NRC ${s.minNrc.toFixed(2)}+`, () => ((form.elements.namedItem('minNrc') as HTMLInputElement).value = '0')]);
      if (s.classA) chips.push(['Class A', () => ((form.elements.namedItem('classA') as HTMLInputElement).checked = false)]);
      const box = document.querySelector<HTMLElement>('[data-chips]')!;
      box.replaceChildren(...chips.map(([text, undo]) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'chip hover:border-ink';
        b.innerHTML = `${text.replace(/[<>&]/g, '')} <span aria-hidden="true">✕</span>`;
        b.setAttribute('aria-label', `Remove filter ${text}`);
        b.addEventListener('click', () => { undo(); apply(); });
        return b;
      }));
      if (chips.length > 1) {
        const c = document.createElement('button');
        c.type = 'button'; c.className = 'text-sm text-green underline'; c.textContent = 'Clear all';
        c.addEventListener('click', clearAll);
        box.append(c);
      }
      document.querySelector('[data-active-n]')!.textContent = chips.length ? `${chips.length} active` : '';
      retargetSamples(s);
      const p = toParams(s);
      if (sortEl.value !== 'featured') p.set('sort', sortEl.value);
      history.replaceState(null, '', `${location.pathname}${p.size ? `?${p}` : ''}`);
    }
    function clearAll() { form.reset(); apply(); }
    form.addEventListener('input', apply);
    form.addEventListener('submit', (e) => e.preventDefault());
    sortEl.addEventListener('change', apply);
    document.querySelector('[data-clear]')!.addEventListener('click', clearAll);
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => {
      grid.dataset.view = b.dataset.view!;
      document.querySelectorAll('[data-view]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    }));
    apply();

    // Compare
    const data = JSON.parse(document.getElementById('compare-data')!.textContent!);
    const tray = document.querySelector<HTMLElement>('[data-tray]')!;
    const dlg = document.querySelector<HTMLDialogElement>('[data-compare-dialog]')!;
    const boxes = [...document.querySelectorAll<HTMLInputElement>('[data-compare]')];
    const sel = () => boxes.filter((b) => b.checked).map((b) => b.value);
    const sync = () => {
      const s = sel();
      tray.hidden = !s.length;
      tray.querySelector('[data-tray-n]')!.textContent = String(s.length);
      tray.querySelector('[data-tray-names]')!.textContent = s.map((x) => data[x].name).join(', ');
      boxes.forEach((b) => (b.disabled = !b.checked && s.length >= 3));
    };
    boxes.forEach((b) => b.addEventListener('change', sync));
    tray.querySelector('[data-tray-clear]')!.addEventListener('click', () => { boxes.forEach((b) => (b.checked = false)); sync(); });
    tray.querySelector('[data-tray-open]')!.addEventListener('click', () => {
      const ps = sel().map((s) => data[s]);
      const esc = (v: unknown) => String(v ?? '—').replace(/[&<>]/g, (c) => `&#${c.charCodeAt(0)};`);
      const td = (v: unknown) => `<td class="border-t border-line p-3 align-top">${esc(Array.isArray(v) ? v.join(', ') : v)}</td>`;
      const row = (k: string, vs: unknown[]) => `<tr><th class="border-t border-line p-3 font-medium text-muted">${esc(k)}</th>${vs.map(td).join('')}</tr>`;
      const keys = [...new Set(ps.flatMap((p) => Object.keys(p.specs)))];
      dlg.querySelector('[data-compare-table]')!.innerHTML =
        `<thead><tr><th></th>${ps.map((p) => `<th class="p-3 align-bottom"><img src="${p.img ?? ''}" alt="" class="mb-2 aspect-[4/3] w-40 rounded-lg object-cover"><span class="text-base">${esc(p.name)}</span></th>`).join('')}</tr></thead><tbody>` +
        row('Material', ps.map((p) => p.material)) + row('NRC', ps.map((p) => p.nrc?.toFixed(2))) + row('Fire', ps.map((p) => p.fire && `Class ${p.fire}`)) + row('Finishes', ps.map((p) => p.finishes)) +
        keys.map((k) => row(k, ps.map((p) => p.specs[k]))).join('') + '</tbody>';
      dlg.showModal();
    });
    dlg.querySelector('[data-compare-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => e.target === dlg && dlg.close());
  </script>
</Layout>
