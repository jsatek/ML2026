---
interface Props { finishes: { name: string; hex: string; image?: string | null }[]; max?: number; }
const { finishes, max = 6 } = Astro.props;
// Spread the preview across the range instead of showing the first N of one group.
const step = Math.max(1, Math.floor(finishes.length / max));
const shown = finishes.filter((_, i) => i % step === 0).slice(0, max);
const extra = finishes.length - shown.length;
---
<div class="flex items-center gap-1" aria-label={`${finishes.length} finishes`}>
  {shown.map((f) => (
    <span class="size-4 rounded-full bg-cover ring-1 ring-black/10" style={`background-color:${f.hex}`} title={f.name}></span>
  ))}
  {extra > 0 && <span class="ml-1 text-xs text-muted">+{extra}</span>}
</div>
