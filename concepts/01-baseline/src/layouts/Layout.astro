---
import '../styles/global.css';
import { site } from '@ml/content';
import wordmark from '@ml/brand/logo/materiallogiq-wordmark.webp';
import mark from '@ml/brand/logo/materiallogiq-mark.svg';
import { url } from '../lib/utils';

interface Props { title?: string; description?: string; }
const { title, description = site.intro } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path === url(href) || path.startsWith(`${url(href)}/`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={mark.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2">Skip to content</a>
    <div class="bg-green text-center text-xs text-white/90 py-1.5">Concept 01 · Baseline · content from materiallogiq.com</div>

    <header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
      <div class="container-x flex h-16 items-center gap-3 md:gap-6 lg:h-20">
        <a href={url("/")} class="shrink-0 py-3" aria-label={`${site.name} home`}>
          <img src={wordmark.src} alt="" class="h-5 w-auto lg:h-6" width="200" height="21" />
        </a>
        <nav aria-label="Primary" class="ml-auto hidden md:block">
          <ul class="flex items-center gap-1">
            {site.nav.map((item) => (
              <li>
                <a
                  href={url(item.href)}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="rounded-full px-4 py-2 font-medium text-ink/80 hover:bg-paper hover:text-ink aria-[current=page]:text-green aria-[current=page]:ml-underline"
                >{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a href={url('/samples')} class="btn btn-primary btn-sm ml-auto md:ml-2">
          Samples
          <span data-cart-count hidden class="grid min-w-5 place-items-center rounded-full bg-sky px-1.5 text-xs font-bold text-green">0</span>
        </a>
        <button type="button" class="grid size-11 place-items-center rounded md:hidden" aria-controls="mobile-nav" aria-expanded="false" data-menu-toggle>
          <span class="sr-only">Menu</span>
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </div>
      <nav id="mobile-nav" aria-label="Primary" class="border-t border-line md:hidden" hidden>
        <ul class="container-x flex flex-col py-2">
          {site.nav.map((item) => (
            <li><a href={url(item.href)} class="block py-3 text-lg font-medium" aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 bg-ink text-white/80">
      <div class="container-x grid gap-10 py-14 md:grid-cols-4">
        <div class="md:col-span-2">
          <img src={mark.src} alt="" class="h-8 w-auto" width="64" height="32" />
          <p class="mt-4 max-w-sm text-sm">{site.intro}</p>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-white">Explore</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {site.nav.map((item) => <li><a href={url(item.href)} class="hover:text-white hover:underline">{item.label}</a></li>)}
            <li><a href={url('/samples')} class="hover:text-white hover:underline">Request samples</a></li>
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-white">Contact</h2>
          <address class="mt-3 space-y-2 text-sm not-italic">
            <p>{site.contact.address}</p>
            <p><a href={`mailto:${site.contact.email}`} class="hover:text-white hover:underline">{site.contact.email}</a></p>
            <p>{site.contact.phone}</p>
          </address>
        </div>
      </div>
    </footer>

    <div role="status" aria-live="polite" class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex justify-center px-4">
      <div data-toast hidden class="pointer-events-auto flex items-center gap-4 rounded-full bg-ink px-5 py-3 text-sm text-white shadow-xl">
        <span data-toast-text></span>
        <button type="button" data-toast-undo hidden class="min-h-11 font-semibold text-sky underline underline-offset-4">Undo</button>
        <a href={url('/samples')} data-toast-view class="flex min-h-11 items-center font-semibold text-sky underline underline-offset-4">View samples</a>
      </div>
    </div>

    <script>
      import * as cart from '@ml/content/cart';

      // Mobile menu
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const mobileNav = document.getElementById('mobile-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        if (mobileNav) mobileNav.hidden = open;
      });

      // Toast
      const toast = document.querySelector<HTMLElement>('[data-toast]');
      let toastTimer: number | undefined;
      let undo: (() => void) | undefined;
      function notify(text: string, onUndo?: () => void) {
        if (!toast) return;
        toast.querySelector('[data-toast-text]')!.textContent = text;
        undo = onUndo;
        toast.querySelector<HTMLElement>('[data-toast-undo]')!.hidden = !onUndo;
        toast.querySelector<HTMLElement>('[data-toast-view]')!.hidden = !!onUndo;
        toast.hidden = false;
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => (toast.hidden = true), onUndo ? 6000 : 3500);
      }

      // Sample buttons + header count
      function sync(items: { product: string; finish: string }[]) {
        document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
          el.textContent = String(items.length);
          el.hidden = items.length === 0;
        });
        document.querySelectorAll<HTMLButtonElement>('[data-add-sample]').forEach((btn) => {
          const inCart = items.some((i) => i.product === btn.dataset.product && i.finish === btn.dataset.finish);
          btn.setAttribute('aria-pressed', String(inCart));
          btn.querySelector('[data-label]')!.textContent = inCart ? 'Added' : btn.dataset.labelAdd ?? 'Add sample';
          btn.querySelector('[data-icon-add]')?.toggleAttribute('hidden', inCart);
          btn.querySelector('[data-icon-added]')?.toggleAttribute('hidden', !inCart);
        });
      }
      cart.onChange(sync);

      document.addEventListener('click', (e) => {
        const target = e.target as Element;
        if (target.closest('[data-toast-undo]')) {
          undo?.();
          toast!.hidden = true;
          return;
        }
        // Product cards: picking a swatch sets which finish the card's sample button adds.
        const pick = target.closest<HTMLButtonElement>('[data-finish-pick]');
        if (pick) {
          const card = pick.closest<HTMLElement>('[data-product-card]')!;
          card.querySelectorAll('[data-finish-pick]').forEach((b) => b.setAttribute('aria-pressed', String(b === pick)));
          card.querySelector('[data-finish-name]')!.textContent = pick.dataset.finishPick!;
          card.querySelector<HTMLElement>('[data-add-sample]')!.dataset.finish = pick.dataset.finishPick!;
          sync(cart.getCart());
          return;
        }
        const btn = target.closest<HTMLButtonElement>('[data-add-sample]');
        if (!btn) return;
        const item = { product: btn.dataset.product!, finish: btn.dataset.finish! };
        const name = btn.dataset.name ?? 'Sample';
        if (cart.has(item)) {
          cart.remove(item);
          notify(`Removed ${name} (${item.finish})`, () => cart.add(item));
          return;
        }
        const result = cart.add(item);
        if (result === 'full') notify(`Sample limit reached (${cart.LIMIT}). Remove one to add another.`);
        else notify(`Added ${name} (${item.finish})`);
      });
    </script>
  </body>
</html>
