---
import Layout from '../../layouts/Layout.astro';
import Placeholder from '../../components/Placeholder.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SampleButton from '../../components/SampleButton.astro';
import { products, getCategory, getResourceType, resourcesForProduct, projectsUsingProduct } from '@ml/content';
import { url } from '../../lib/utils';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product: p } = Astro.props;
const category = getCategory(p.category)!;
const docs = resourcesForProduct(p.slug);
const specSheet = docs.find((d) => d.type === 'spec-sheet');
const usedIn = projectsUsingProduct(p.slug);
const related = products.filter((o) => o.category === p.category && o.slug !== p.slug).slice(0, 3);
const first = p.finishes[0];
---
<Layout title={p.name} description={p.tagline}>
  <div class="container-x pt-6">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <ol class="flex flex-wrap gap-2">
        <li><a href={url('/products')} class="hover:underline">Products</a> /</li>
        <li><a href={url(`/products?category=${category.slug}`)} class="hover:underline">{category.name}</a> /</li>
        <li aria-current="page" class="text-ink">{p.name}</li>
      </ol>
    </nav>
  </div>

  <!-- Overview -->
  <section class="container-x grid gap-10 py-8 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <Placeholder color={first.hex} seed={0} class="aspect-[4/3] rounded-3xl" label="Product photo" />
      <div class="mt-3 grid grid-cols-3 gap-3">
        {[1, 2, 3].map((s) => <Placeholder color={first.hex} seed={s} class="aspect-square rounded-xl" />)}
      </div>
    </div>

    <div class="lg:col-span-5 lg:pt-4">
      <p class="eyebrow">{category.name}</p>
      <h1 class="mt-2 text-4xl sm:text-5xl">{p.name}</h1>
      <p class="mt-3 text-lg text-muted">{p.tagline}</p>

      <fieldset class="mt-8">
        <legend class="text-sm font-semibold">Finish: <span class="font-normal" data-finish-name>{first.name}</span></legend>
        <div class="mt-3 flex flex-wrap gap-2" role="radiogroup">
          {p.finishes.map((f, i) => (
            <label class="cursor-pointer" title={f.name}>
              <input type="radio" name="finish" value={f.name} data-hex={f.hex} checked={i === 0} class="peer sr-only" />
              <span class="block size-11 rounded-full ring-1 ring-black/15 ring-offset-2 transition peer-checked:ring-2 peer-checked:ring-green peer-focus-visible:outline-3 peer-focus-visible:outline-orange" style={`background:${f.hex}`}>
                <span class="sr-only">{f.name}</span>
              </span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="mt-8 flex flex-wrap gap-3">
        <SampleButton product={p.slug} name={p.name} finish={first.name} label={`Add ${first.name} sample`} class="btn btn-primary" />
        {specSheet && <a href={specSheet.href} class="btn btn-outline text-green">Spec sheet <span class="text-xs font-normal">PDF {specSheet.size}</span></a>}
      </div>

      <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line text-sm sm:grid-cols-3">
        {[
          ['Fire rating', p.specs['Fire rating'].split(' (')[0]],
          ['Thickness', p.specs.Thickness],
          ['Lead time', `${p.attributes.leadTimeWeeks} weeks`],
        ].map(([k, v]) => (
          <div class="bg-white p-4"><dt class="text-muted">{k}</dt><dd class="mt-1 font-semibold">{v}</dd></div>
        ))}
      </dl>
      <p class="mt-6 text-sm text-muted">Applications: {p.applications.join(' · ')}</p>
    </div>
  </section>

  <!-- In-page nav -->
  <nav aria-label="On this page" class="sticky top-16 z-20 border-y border-line bg-white/95 backdrop-blur lg:top-20">
    <ul class="container-x flex gap-6 overflow-x-auto text-sm font-medium">
      {[['overview', 'Overview'], ['specs', 'Specifications'], ['documents', `Documents (${docs.length})`], ['projects', `Projects (${usedIn.length})`]].map(([id, label]) => (
        <li><a href={`#${id}`} class="block whitespace-nowrap py-4 hover:text-green">{label}</a></li>
      ))}
    </ul>
  </nav>

  <section id="overview" class="container-x grid scroll-mt-40 gap-10 py-16 lg:grid-cols-12">
    <h2 class="text-2xl lg:col-span-4">Overview</h2>
    <div class="lg:col-span-8">
      <p class="text-lg">{p.description}</p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {p.features.map((f) => (
          <li class="flex gap-3 rounded-xl bg-paper p-4">
            <svg class="mt-0.5 size-5 shrink-0 text-teal" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M4 10.5l4 4 8-9" /></svg>
            {f}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="specs" class="container-x grid scroll-mt-40 gap-10 border-t border-line py-16 lg:grid-cols-12">
    <h2 class="text-2xl lg:col-span-4">Specifications</h2>
    <dl class="divide-y divide-line lg:col-span-8">
      {Object.entries(p.specs).map(([k, v]) => (
        <div class="grid grid-cols-2 gap-4 py-3">
          <dt class="text-muted">{k}</dt>
          <dd class="font-medium">{Array.isArray(v) ? v.join(', ') : v}</dd>
        </div>
      ))}
      <div class="grid grid-cols-2 gap-4 py-3">
        <dt class="text-muted">Finishes</dt>
        <dd class="font-medium">{p.finishes.map((f) => f.name).join(', ')}</dd>
      </div>
    </dl>
  </section>

  <section id="documents" class="container-x grid scroll-mt-40 gap-10 border-t border-line py-16 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 class="text-2xl">Documents</h2>
      <a href={url(`/resources?product=${p.slug}`)} class="link mt-3 inline-block text-sm">Open in resource library</a>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2 lg:col-span-8">
      {docs.map((d) => (
        <li>
          <a href={d.href} class="flex items-center gap-4 rounded-xl border border-line p-4 hover:border-teal">
            <span class="grid size-11 shrink-0 place-items-center rounded-lg bg-sky/40 text-xs font-bold text-green">{d.format}</span>
            <span class="min-w-0 flex-1">
              <span class="block truncate font-medium">{getResourceType(d.type)?.name}</span>
              <span class="text-sm text-muted">{d.size} · Updated {d.updated}</span>
            </span>
            <svg class="size-5 text-muted" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 3v10m0 0l-4-4m4 4l4-4M4 16h12" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {usedIn.length > 0 && (
    <section id="projects" class="scroll-mt-40 bg-paper py-16">
      <div class="container-x">
        <h2 class="text-2xl">Projects using {p.name}</h2>
        <div class="mt-8 grid gap-8 md:grid-cols-3">
          {usedIn.map((proj, i) => <ProjectCard project={proj} index={i} />)}
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="container-x py-16">
      <h2 class="text-2xl">More {category.name.toLowerCase()}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((r, i) => <ProductCard product={r} index={i + 1} />)}
      </div>
    </section>
  )}

  <script>
    // Finish picker: recolor the imagery and retarget the sample button.
    const btn = document.querySelector<HTMLButtonElement>('.btn-primary[data-add-sample]')!;
    const nameEl = document.querySelector('[data-finish-name]')!;
    document.querySelectorAll<HTMLInputElement>('input[name=finish]').forEach((input) =>
      input.addEventListener('change', () => {
        nameEl.textContent = input.value;
        btn.dataset.finish = input.value;
        btn.dataset.labelAdd = `Add ${input.value} sample`;
        document.querySelectorAll<HTMLElement>('main section:first-of-type [data-placeholder]').forEach((el) => {
          el.style.setProperty('--c', input.dataset.hex!);
        });
        window.dispatchEvent(new CustomEvent('ml:cart'));
      }),
    );
  </script>
</Layout>
