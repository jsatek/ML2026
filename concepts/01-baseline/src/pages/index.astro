---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import ProductCard from '../components/ProductCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, categories, materials, products, projects, productsInCategory, resources } from '@ml/content';
import { url } from '../lib/utils';

const featured = products.filter((p) => p.featured).slice(0, 4);
const featuredProjects = [...projects.filter((p) => p.featured), ...projects.filter((p) => !p.featured)].slice(0, 3);
const heroBands = featured.slice(0, 3).map((p, i) => ({ src: p.images.hero, color: ['#8BD3DD', '#2B8F92', '#00574F'][i] }));
const groups = [...new Set(categories.map((c) => c.group))];
const [taglineStart, lastWord] = [site.tagline.split(' ').slice(0, -1).join(' '), site.tagline.split(' ').at(-1)];
---
<Layout>
  <!-- Hero -->
  <section class="overflow-hidden">
    <div class="container-x grid items-center gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-6">
        <h1 class="text-5xl leading-[1.02] sm:text-6xl lg:text-7xl">
          {taglineStart} <span class="ml-underline decoration-orange">{lastWord}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-muted">{site.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={url('/products')} class="btn btn-primary">Explore products</a>
          <a href={url('/samples')} class="btn btn-outline text-green">Order samples</a>
        </div>
      </div>
      <!-- Logo-derived bands filled with product photography -->
      <div class="relative lg:col-span-6" aria-hidden="true">
        <div class="relative mx-auto aspect-[5/4] max-w-xl">
          {heroBands.map((b, i) => (
            <div
              class="absolute inset-y-0 w-[38%] overflow-hidden"
              style={`left:${i * 31}%; clip-path: polygon(${i === 0 ? '0 100%, 60% 100%, 100% 0, 40% 0' : '0 0, 60% 0, 100% 100%, 40% 100%'}); background:${b.color}`}
            >
              <Placeholder src={b.src} color={b.color} seed={i} class="h-full w-full" eager />
              <div class="absolute inset-0 mix-blend-multiply" style={`background:${b.color}; opacity:.35`}></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Surface x material index -->
  <section class="bg-paper py-20" aria-labelledby="cat-heading">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="cat-heading" class="text-3xl sm:text-4xl">Start with the surface you're treating</h2>
        <a href={url('/products')} class="link">View all {products.length} products</a>
      </div>
      <div class="mt-10">
        <table class="w-full border-collapse text-left">
          <caption class="sr-only">Product systems by product type and material</caption>
          <thead>
            <tr class="border-b-2 border-ink">
              <th scope="col" class="py-3 pr-4 text-sm font-semibold text-muted">Product type</th>
              {materials.map((m) => (
                <th scope="col" class="px-1.5 py-3 text-right align-bottom text-sm font-semibold sm:px-3">
                  <a href={url(`/products?material=${m.slug}`)} class="hover:ml-underline">{m.name}</a>
                </th>
              ))}
            </tr>
          </thead>
          {groups.map((g) => (
            <tbody>
              <tr><th colspan={materials.length + 1} scope="colgroup" class="pb-2 pt-6 text-left text-sm font-semibold text-muted">{g}</th></tr>
              {categories.filter((c) => c.group === g).map((c) => (
                <tr class="border-b border-line">
                  <th scope="row" class="py-3 pr-4 font-bold">
                    <a href={url(`/products?type=${c.slug}`)} class="hover:ml-underline">{c.name}</a>
                    <span class="ml-2 text-sm font-normal text-muted">{productsInCategory(c.slug).length}</span>
                  </th>
                  {materials.map((m) => {
                    const n = productsInCategory(c.slug).filter((p) => p.material === m.slug).length;
                    return (
                      <td class="px-1.5 py-3 text-right tabular-nums sm:px-3">
                        {n
                          ? <a href={url(`/products?type=${c.slug}&material=${m.slug}`)} class="font-semibold text-green hover:ml-underline" aria-label={`${n} ${m.name} ${c.name}`}>{n}</a>
                          : <><span aria-hidden="true" class="text-muted">–</span><span class="sr-only">none</span></>}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </section>

  <!-- Featured products -->
  <section class="py-20" aria-labelledby="featured-heading">
    <div class="container-x">
      <h2 id="featured-heading" class="text-3xl sm:text-4xl">Featured products</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((p, i) => <ProductCard product={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="bg-green py-20 text-white" aria-labelledby="proj-heading">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="proj-heading" class="text-3xl sm:text-4xl">Projects</h2>
        <a href={url('/projects')} class="font-semibold text-white underline decoration-sky decoration-2 underline-offset-4">All projects</a>
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {featuredProjects.map((p, i) => <ProjectCard project={p} index={i} dark />)}
      </div>
    </div>
  </section>

  <!-- Materialize process -->
  <section class="py-20" aria-labelledby="process-heading">
    <div class="container-x">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 id="process-heading" class="text-3xl sm:text-4xl">{site.materialize.title}</h2>
          <p class="mt-4 text-muted">{site.materialize.text}</p>
        </div>
        <ol class="grid content-start gap-x-6 border-t-2 border-ink sm:grid-cols-5 lg:col-span-8">
          {site.process.map((s, i) => (
            <li class="border-b border-line py-4 sm:border-b-0">
              <h3 class="text-lg"><span class="mr-2 text-sm font-semibold tabular-nums text-teal-ink">{i + 1}</span>{s.step}</h3>
              <p class="mt-1 text-sm text-muted">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Samples + resources -->
  <section class="container-x grid gap-12 border-t border-line py-16 lg:grid-cols-2" aria-label="Samples and resources">
    <div>
      <h2 class="text-3xl">Touch it before you specify it</h2>
      <p class="mt-2 text-muted">Pick colors and finishes from any product and we'll ship up to {site.sampleLimit} samples.</p>
      <a href={url('/samples')} class="btn btn-primary mt-6">Start a sample request</a>
    </div>
    <div>
      <h2 class="text-3xl">Data sheets, CAD, BIM and more</h2>
      <p class="mt-2 text-muted">{resources.length} documents across every product, in one searchable library.</p>
      <form action={url('/resources')} method="get" role="search" class="mt-6 flex gap-2">
        <label for="home-res-q" class="sr-only">Search resources</label>
        <input id="home-res-q" name="q" type="search" placeholder="e.g. COFFA installation" class="field" />
        <button class="btn btn-primary shrink-0">Search</button>
      </form>
    </div>
  </section>
</Layout>
