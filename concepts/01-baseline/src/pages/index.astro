---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import SampleButton from '../components/SampleButton.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, categories, materials, products, projects, productsInCategory, productsInMaterial, resources, getMaterial, specSummary, formatNrc, finishWall } from '@ml/content';
import { url } from '../lib/utils';

const featured = products.filter((p) => p.featured).slice(0, 4);
const featuredProjects = [...projects.filter((p) => p.featured), ...projects.filter((p) => !p.featured)].slice(0, 3);
const heroBands = featured.slice(0, 3).map((p, i) => ({ src: p.images.hero, color: ['#8BD3DD', '#2B8F92', '#00574F'][i] }));
const groups = [...new Set(categories.map((c) => c.group))];
const all = specSummary(products);
const wall = finishWall();
const wallTotal = wall.reduce((n, w) => n + w.count, 0);
const wallProducts = Object.fromEntries(products.map((p) => [p.slug, { name: p.name, href: url(`/products/${p.slug}`) }]));
const silk = getMaterial('silk-metal')!;
const silkProducts = productsInMaterial(silk.slug);
const silkSpec = specSummary(silkProducts);
const silkSentences = silk.summary.match(/[^.!?]+[.!?]+/g) ?? [];
const silkAt = silkSentences.findIndex((t) => t.includes('perforations'));
const silkCopy = silkAt >= 0 ? silkSentences.slice(silkAt, silkAt + 2).join(' ').trim() : silk.aka;
const silkHero = silkProducts.find((p) => p.slug === 'silk-metal-grille') ?? silkProducts[0];
const [taglineStart, lastWord] = [site.tagline.split(' ').slice(0, -1).join(' '), site.tagline.split(' ').at(-1)];
---
<Layout>
  <!-- Hero -->
  <section class="overflow-hidden">
    <div class="container-x grid items-center gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-6">
        <h1 class="text-5xl leading-[1.02] sm:text-6xl lg:text-7xl">
          {taglineStart} <span class="ml-underline">{lastWord}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-muted">{site.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={url('/products')} class="btn btn-primary">Explore products</a>
          <a href={url('/samples')} class="btn btn-outline text-green">Order samples</a>
        </div>
      </div>
      <!-- Logo-derived bands filled with product photography -->
      <div class="relative lg:col-span-6" aria-hidden="true">
        <div class="relative mx-auto aspect-[5/4] max-w-xl">
          {heroBands.map((b, i) => (
            <div
              class="absolute inset-y-0 w-[38%] overflow-hidden"
              style={`left:${i * 31}%; clip-path: polygon(${i === 0 ? '0 100%, 60% 100%, 100% 0, 40% 0' : '0 0, 60% 0, 100% 100%, 40% 100%'}); background:${b.color}`}
            >
              <Placeholder src={b.src} color={b.color} seed={i} class="h-full w-full" eager />
              <div class="absolute inset-0 mix-blend-multiply" style={`background:${b.color}; opacity:.35`}></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Surface x material index -->
  <section class="bg-paper py-20" aria-labelledby="cat-heading">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="cat-heading" class="text-3xl sm:text-4xl">Start with the surface you're treating</h2>
        <a href={url('/products')} class="link">View all {products.length} products</a>
      </div>
      <div class="mt-10">
        <table class="w-full border-collapse text-left">
          <caption class="sr-only">Product systems by product type and material</caption>
          <thead>
            <tr class="border-b-2 border-ink">
              <th scope="col" class="py-3 pr-4 text-sm font-semibold text-muted">Product type</th>
              {materials.map((m) => (
                <th scope="col" class="px-1.5 py-3 text-right align-bottom text-sm font-semibold sm:px-3">
                  <a href={url(`/products?material=${m.slug}`)} class="hover:ml-underline">{m.name}</a>
                </th>
              ))}
              <th scope="col" class="hidden py-3 pl-6 text-right align-bottom text-sm font-semibold sm:table-cell">NRC</th>
            </tr>
          </thead>
          {groups.map((g) => (
            <tbody>
              <tr><th colspan={materials.length + 2} scope="colgroup" class="pb-2 pt-6 text-left text-sm font-semibold text-muted">{g}</th></tr>
              {categories.filter((c) => c.group === g).map((c) => (
                <tr class="border-b border-line">
                  <th scope="row" class="py-3 pr-4 font-bold">
                    <a href={url(`/products?type=${c.slug}`)} class="hover:ml-underline">{c.name}</a>
                    <span class="ml-2 text-sm font-normal text-muted">{productsInCategory(c.slug).length}</span>
                  </th>
                  {materials.map((m) => {
                    const n = productsInCategory(c.slug).filter((p) => p.material === m.slug).length;
                    return (
                      <td class="px-1.5 py-3 text-right tabular-nums sm:px-3">
                        {n
                          ? <a href={url(`/products?type=${c.slug}&material=${m.slug}`)} class="font-semibold text-green hover:ml-underline" aria-label={`${n} ${m.name} ${c.name}`}>{n}</a>
                          : <><span aria-hidden="true" class="text-muted">–</span><span class="sr-only">none</span></>}
                      </td>
                    );
                  })}
                  <td class="hidden py-3 pl-6 text-right tabular-nums text-muted sm:table-cell">{formatNrc(specSummary(productsInCategory(c.slug))) ?? '–'}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
      <p class="mt-4 text-sm text-muted">
        {all.fire.length === 1 && <>All {all.count} systems are fire rated Class {all.fire[0]}. </>}
        NRC is the range across products of each type{all.nrcUnknown > 0 && <>; {all.nrcUnknown} products have no published NRC</>}.
      </p>
    </div>
  </section>

  <!-- Samples + resources -->
  <section class="container-x grid gap-12 py-16 lg:grid-cols-2" aria-label="Samples and resources">
    <div>
      <h2 class="text-3xl">Touch it before you specify it</h2>
      <p class="mt-2 text-muted">Pick colors and finishes from any product, up to {site.sampleLimit} per request.</p>
      <a href={url('/samples')} class="btn btn-primary mt-6">Start a sample request</a>
    </div>
    <div>
      <h2 class="text-3xl">Data sheets, CAD, BIM and more</h2>
      <p class="mt-2 text-muted">{resources.length} documents across every product, in one searchable library.</p>
      <form action={url('/resources')} method="get" role="search" class="mt-6 flex gap-2">
        <label for="home-res-q" class="sr-only">Search resources</label>
        <input id="home-res-q" name="q" type="search" placeholder="Product or document, e.g. COFFA installation" class="field" />
        <button class="btn btn-primary shrink-0">Search</button>
      </form>
    </div>
  </section>

  <!-- Silk Metal -->
  <section class="bg-ink py-20 text-white" aria-labelledby="silk-heading">
    <div class="container-x grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="silk-heading" class="text-4xl sm:text-5xl">{silk.name}</h2>
        <p class="mt-2 text-lg text-sky">{silk.aka}</p>
        <p class="mt-6 text-white/80">{silkCopy}</p>
        <dl class="mt-8 grid grid-cols-3 gap-6 border-t border-white/20 pt-6">
          <div><dt class="text-sm text-white/70">NRC</dt><dd class="mt-1 text-2xl font-bold tabular-nums">{formatNrc(silkSpec) ?? '–'}</dd></div>
          <div><dt class="text-sm text-white/70">Fire</dt><dd class="mt-1 text-2xl font-bold">{silkSpec.fire.map((r) => `Class ${r}`).join(', ') || '–'}</dd></div>
          <div><dt class="text-sm text-white/70">Finishes</dt><dd class="mt-1 text-2xl font-bold tabular-nums">{silkSpec.finishes.length}</dd></div>
        </dl>
        <a href={url(`/products?material=${silk.slug}`)} class="btn mt-8 bg-white text-green hover:bg-sky">See all {silkSpec.count} {silk.name} systems</a>
      </div>
      <div class="lg:col-span-7">
        <Placeholder src={silkHero.images.hero} color={silkSpec.finishes[0]?.hex} seed={2} class="aspect-[16/10] rounded-2xl" />
        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={`${silk.name} finishes`}>
          {silkSpec.finishes.map((f) => <li class="size-6 rounded-full ring-1 ring-white/20" style={`background:${f.hex}`} title={f.name}><span class="sr-only">{f.name}</span></li>)}
        </ul>
        <p class="mt-2 text-sm text-white/70">{silkSpec.finishGroups.join(' · ')}</p>
      </div>
    </div>
  </section>

  <!-- Finish wall -->
  <section class="py-20" aria-labelledby="wall-heading" data-finish-wall>
    <div class="container-x">
      <h2 id="wall-heading" class="text-3xl sm:text-4xl">Every finish, by material</h2>
      <p class="mt-2 max-w-2xl text-muted">{wallTotal} finishes across {wall.length} materials. Pick one to see which products come in it and add a sample.</p>
      <script type="application/json" data-wall-products set:html={JSON.stringify(wallProducts)}></script>
      <div class="mt-10 grid gap-10 lg:grid-cols-12">
        <div class="space-y-10 lg:col-span-8">
          {wall.map((w) => (
            <div>
              <h3 class="flex items-baseline justify-between gap-4 border-b border-line pb-2 text-xl">
                {w.material.name}
                <a href={url(`/products?material=${w.material.slug}`)} class="inline-flex min-h-6 items-center text-sm font-semibold text-green hover:ml-underline">{w.count} finishes</a>
              </h3>
              {w.groups.map((g) => (
                <div class="mt-4">
                  <p class="text-sm text-muted">{g.name}</p>
                  <ul class="mt-2 grid grid-cols-[repeat(auto-fill,minmax(2.25rem,1fr))] gap-1.5">
                    {g.finishes.map((f) => (
                      <li>
                        <a
                          href={url(`/products/${f.products[0]}`)}
                          class="swatch block aspect-square rounded-md ring-1 ring-black/10 ring-inset"
                          style={`background:${f.hex}`}
                          title={f.name}
                          data-swatch data-name={f.name} data-hex={f.hex} data-image={f.image ?? ''} data-group={g.name} data-material={w.material.name} data-products={f.products.join(' ')}
                        ><span class="sr-only">{f.name}, {w.material.name}</span></a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ))}
        </div>
        <div class="lg:col-span-4">
          <div data-wall-panel hidden aria-live="polite" class="fixed inset-x-0 bottom-0 z-40 max-h-[70svh] overflow-y-auto rounded-t-3xl bg-white p-6 shadow-[0_-8px_30px_rgb(0_0_0/0.15)] lg:sticky lg:top-24 lg:z-auto lg:max-h-none lg:rounded-2xl lg:border lg:border-line lg:shadow-none">
            <div class="flex items-start gap-4">
              <div data-wall-chip class="size-20 shrink-0 rounded-xl bg-cover bg-center ring-1 ring-black/10 ring-inset"></div>
              <div class="min-w-0 flex-1">
                <p data-wall-name class="text-xl font-bold"></p>
                <p data-wall-meta class="text-sm text-muted"></p>
                <p data-wall-count class="mt-1 text-sm font-semibold text-green"></p>
              </div>
              <button type="button" data-wall-close class="-mr-2 -mt-2 rounded-full p-2 text-muted hover:bg-paper hover:text-ink" aria-label="Close finish details">
                <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
              </button>
            </div>
            <ul data-wall-rows class="mt-5 divide-y divide-line border-t border-line"></ul>
            <template data-wall-row>
              <li class="flex items-center justify-between gap-3 py-3">
                <a data-row-link data-row-name class="font-semibold hover:ml-underline"></a>
                <SampleButton product="" name="" finish="" class="btn btn-outline btn-sm shrink-0 whitespace-nowrap text-green" />
              </li>
            </template>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="bg-green py-20 text-white" aria-labelledby="proj-heading">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="proj-heading" class="text-3xl sm:text-4xl">Projects</h2>
        <a href={url('/projects')} class="font-semibold text-white underline decoration-sky decoration-2 underline-offset-4">All projects</a>
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {featuredProjects.map((p, i) => <ProjectCard project={p} index={i} dark />)}
      </div>
    </div>
  </section>

  <!-- Materialize process -->
  <section class="py-20" aria-labelledby="process-heading">
    <div class="container-x">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 id="process-heading" class="text-3xl sm:text-4xl">{site.materialize.title}</h2>
          <p class="mt-4 text-muted">{site.materialize.text}</p>
        </div>
        <ol class="grid content-start gap-x-6 border-t-2 border-ink sm:grid-cols-5 lg:col-span-8">
          {site.process.map((s, i) => (
            <li class="border-b border-line py-4 sm:border-b-0">
              <h3 class="text-lg"><span class="mr-2 text-sm font-semibold tabular-nums text-teal-ink">{i + 1}</span>{s.step}</h3>
              <p class="mt-1 text-sm text-muted">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <script>
    import { bindFinishWall } from '@ml/content/finish-wall';
    bindFinishWall();
  </script>
</Layout>
