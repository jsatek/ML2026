---
import Layout from '../../layouts/Layout.astro';
import Placeholder from '../../components/Placeholder.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SampleButton from '../../components/SampleButton.astro';
import { projects, getProduct, getCategory, getMaterial, site } from '@ml/content';
import { url } from '../../lib/utils';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project: p } = Astro.props;
const used = p.products.map((s) => getProduct(s)!).filter(Boolean);
const more = [...projects.filter((o) => o.slug !== p.slug && o.sector === p.sector), ...projects.filter((o) => o.slug !== p.slug && o.sector !== p.sector)].slice(0, 3);
const facts = [
  ['Market', p.sector],
  ['Location', p.location],
  ['Completed', p.year],
  ['Material', p.materials.map((m) => getMaterial(m)?.name).join(', ')],
  ['Application', p.applications.join(', ')],
  ['Product', p.custom ? 'Custom (Materialize)' : used.map((u) => u.name).join(', ')],
].filter(([, v]) => v);
---
<Layout title={p.name} description={p.summary}>
  <section class="container-x pt-6">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href={url('/projects')} class="hover:underline">Projects</a> / <span class="text-ink">{p.name}</span>
    </nav>
    <div class="mt-6 max-w-3xl">
      <p class="eyebrow">{p.sector} · {p.location}</p>
      <h1 class="mt-2 text-4xl sm:text-6xl">{p.name}</h1>
      <p class="mt-4 text-lg text-muted">{p.summary}</p>
      {p.placeholder && <p class="mt-4 inline-block rounded-full bg-orange/15 px-3 py-1 text-sm font-medium text-ink">Example project: real product photo, invented case study</p>}
    </div>
    <Placeholder src={p.images[0]} alt={p.name} class="mt-10 aspect-[16/9] rounded-3xl" eager />
  </section>

  <section class="container-x grid grid-cols-1 gap-12 py-16 lg:grid-cols-12">
    <dl class="grid h-fit grid-cols-2 gap-6 rounded-2xl bg-paper p-6 lg:col-span-4 lg:grid-cols-1">
      {facts.map(([k, v]) => <div><dt class="text-sm text-muted">{k}</dt><dd class="font-semibold">{v}</dd></div>)}
    </dl>
    <div class="space-y-6 text-lg lg:col-span-8">
      {p.story.map((para) => <p>{para}</p>)}
      {p.quote && (
        <blockquote class="border-l-4 border-teal py-2 pl-6">
          <p class="ml-underline text-2xl font-bold leading-snug">“{p.quote.text}”</p>
          <footer class="mt-3 text-base text-muted">{p.quote.by}</footer>
        </blockquote>
      )}
      {p.images.length > 1 && (
        <div class="grid grid-cols-2 gap-4 pt-4">
          {p.images.slice(1, 5).map((src) => <Placeholder src={src} class="aspect-[4/3] rounded-2xl" />)}
        </div>
      )}
    </div>
  </section>

  {used.length > 0 ? (
    <section class="bg-paper py-16" aria-labelledby="used-heading">
      <div class="container-x">
        <h2 id="used-heading" class="text-2xl">Products in this project</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-3">
          {used.map((u, i) => (
            <li class="flex gap-4 rounded-2xl bg-white p-4">
              <Placeholder src={u.images.hero} color={u.finishes[0]?.hex} seed={i} class="size-24 shrink-0 rounded-xl" />
              <div class="flex min-w-0 flex-col">
                <p class="text-xs text-muted">{getMaterial(u.material)?.name} · {getCategory(u.category)?.name}</p>
                <a href={url(`/products/${u.slug}`)} class="font-semibold hover:ml-underline">{u.name}</a>
                {u.finishes[0] && <p class="text-sm text-muted">{u.finishes[0].name}</p>}
                {u.finishes[0] && <div class="mt-auto pt-2"><SampleButton product={u.slug} name={u.name} finish={u.finishes[0].name} label="Sample" /></div>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : (
    <section class="bg-green py-16 text-white">
      <div class="container-x flex flex-wrap items-center justify-between gap-6">
        <div class="max-w-2xl">
          <h2 class="text-2xl">A custom solution, made with Materialize</h2>
          <p class="mt-2 text-white/80">{site.materialize.text}</p>
        </div>
        <a href={`mailto:${site.contact.email}`} class="btn bg-white text-green hover:bg-sky">Start a conversation</a>
      </div>
    </section>
  )}

  <section class="container-x py-16">
    <h2 class="text-2xl">More projects</h2>
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      {more.map((m, i) => <ProjectCard project={m} index={i + 2} />)}
    </div>
  </section>
</Layout>
