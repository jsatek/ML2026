---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, sectors, products } from '@ml/content';

const used = products.filter((p) => projects.some((proj) => proj.products.includes(p.slug)));
---
<Layout title="Projects" description="Material Logiq products in built projects.">
  <section class="border-b border-line bg-paper">
    <div class="container-x py-12">
      <h1 class="text-4xl sm:text-5xl">Projects</h1>
      <p class="mt-3 max-w-2xl text-muted">A portfolio built not on products, but on problems solved, relationships built, and spaces worth experiencing.</p>
    </div>
  </section>

  <div class="container-x py-10">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div role="group" aria-label="Filter by sector" class="flex flex-wrap gap-2">
        <button type="button" class="chip" aria-pressed="true" data-sector="">All</button>
        {sectors.filter((s) => projects.some((p) => p.sector === s)).map((s) => <button type="button" class="chip" aria-pressed="false" data-sector={s}>{s}</button>)}
      </div>
      <label class="flex items-center gap-2 text-sm">
        Product
        <select class="field !w-auto !py-2" data-product-filter>
          <option value="">Any product</option>
          {used.map((p) => <option value={p.slug}>{p.name}</option>)}
        </select>
      </label>
    </div>

    <p class="mt-6 text-sm text-muted" aria-live="polite"><span data-count>{projects.length}</span> projects</p>
    <div class="mt-4 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-grid>
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
    <p data-empty hidden class="mt-6 rounded-2xl border border-dashed border-line p-12 text-center">No projects match. Try another sector or product.</p>
  </div>

  <script>
    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-sector]')];
    const select = document.querySelector<HTMLSelectElement>('[data-product-filter]')!;
    const cards = [...document.querySelectorAll<HTMLElement>('[data-project-card]')];
    const params = new URLSearchParams(location.search);
    let sector = params.get('sector') ?? '';
    select.value = params.get('product') ?? '';

    function apply() {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.sector === sector)));
      let n = 0;
      for (const card of cards) {
        const ok = (!sector || card.dataset.sector === sector) && (!select.value || card.dataset.products!.split('|').includes(select.value));
        card.hidden = !ok;
        if (ok) n++;
      }
      document.querySelector('[data-count]')!.textContent = String(n);
      document.querySelector<HTMLElement>('[data-empty]')!.hidden = n > 0;
      const next = new URLSearchParams();
      if (sector) next.set('sector', sector);
      if (select.value) next.set('product', select.value);
      history.replaceState(null, '', `${location.pathname}${next.size ? `?${next}` : ''}`);
    }
    chips.forEach((c) => c.addEventListener('click', () => { sector = c.dataset.sector!; apply(); }));
    select.addEventListener('change', apply);
    apply();
  </script>
</Layout>
