---
interface Props { product: string; name: string; finish: string; label?: string; class?: string; }
const { product, name, finish, label = 'Add sample', class: cls = 'btn btn-line' } = Astro.props;
---
<button type="button" class={cls} aria-pressed="false" data-add-sample data-product={product} data-name={name} data-finish={finish} data-label-add={label}>
  <svg class="size-4 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 4v12M4 10h12" /></svg>
  <span data-label>{label}</span>
</button>
