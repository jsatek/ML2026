---
import Media from './Media.astro';
import { getMaterial, getCategory } from '@ml/content';
import { url } from '../lib/utils';

interface Props { product: any; eager?: boolean; }
const { product: p, eager = false } = Astro.props;
const material = getMaterial(p.material);
const nrc = p.attributes.nrc;
const dots = p.finishes.slice(0, 10);
---
<article class="group relative flex flex-col" data-card
  data-material={p.material} data-types={p.types.join(' ')} data-nrc={nrc ?? ''} data-fire={p.attributes.fireRating ?? ''}>
  <Media src={p.images.hero} color={p.finishes[0]?.hex} eager={eager} class="aspect-[4/3]" imgClass="transition duration-500 ease-out group-hover:scale-[1.03]" />
  <div class="mt-4 flex items-baseline justify-between gap-4">
    <h3 class="text-lg">
      <a href={url(`/products/${p.slug}`)} class="after:absolute after:inset-0 group-hover:underline">{p.name}</a>
    </h3>
    <p class="num shrink-0 text-sm text-muted">{nrc != null ? `NRC ${nrc.toFixed(2)}` : 'NRC n/a'}{p.attributes.fireRating && ` · Class ${p.attributes.fireRating}`}</p>
  </div>
  <p class="text-sm text-muted">{material?.name} · {p.types.map((t: string) => getCategory(t)?.name).join(', ')}</p>
  <div class="mt-3 flex items-center gap-1" aria-label={`${p.finishes.length} finishes`}>
    {dots.map((f: any) => <span class="size-3.5 rounded-sm shadow-[inset_0_0_0_1px_rgb(0_0_0/.12)]" style={`background:${f.hex}`} title={f.name}></span>)}
    {p.finishes.length > dots.length && <span class="num ml-1 text-xs text-muted">+{p.finishes.length - dots.length}</span>}
  </div>
</article>
