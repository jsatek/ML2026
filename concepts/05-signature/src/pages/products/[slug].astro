---
import Layout from '../../layouts/Layout.astro';
import Media from '../../components/Media.astro';
import FinishChip from '../../components/FinishChip.astro';
import ProductCard from '../../components/ProductCard.astro';
import {
  products, getMaterial, getCategory, resourcesForProduct, resourceTypes,
  projectsUsingProduct, relatedProducts,
} from '@ml/content';
import { url } from '../../lib/utils';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const material = getMaterial(p.material)!;
const types = p.types.map((t) => getCategory(t)!).filter(Boolean);
const gallery = [...new Set([p.images.hero, ...p.images.gallery].filter(Boolean))];
const finishGroups = [...new Set(p.finishes.map((f) => f.group ?? 'Finishes'))].map((g) => ({ name: g, finishes: p.finishes.filter((f) => (f.group ?? 'Finishes') === g) }));

// Documents in the sets a specifier works through.
const docSets = [
  { name: 'Specification', types: ['csi-spec'] },
  { name: 'Drawings', types: ['cad', 'details'] },
  { name: 'Technical', types: ['data-sheet', 'tests'] },
  { name: 'Sustainability', types: ['sustainability'] },
  { name: 'Install and care', types: ['installation', 'care', 'sds', 'warranty'] },
];
const docs = resourcesForProduct(p.slug);
const typeName = (slug: string) => resourceTypes.find((t) => t.slug === slug)?.name ?? slug;
const sets = docSets.map((s) => ({ ...s, docs: docs.filter((d) => s.types.includes(d.type)) })).filter((s) => s.docs.length);
const used = projectsUsingProduct(p.slug);
const related = relatedProducts(p).slice(0, 3);
const specs = Object.entries(p.specs) as [string, string | string[]][];
const nrc = p.attributes.nrc;
---
<Layout title={p.name} description={p.tagline}>
  <nav aria-label="Breadcrumb" class="wrap pt-6 text-sm text-muted">
    <a href={url('/products')} class="hover:text-ink">Products</a>
    <span aria-hidden="true"> / </span>
    <a href={url(`/products?material=${material.slug}`)} class="hover:text-ink">{material.name}</a>
    <span aria-hidden="true"> / </span><span aria-current="page" class="text-ink">{p.name}</span>
  </nav>

  <div class="wrap mt-6 grid gap-10 lg:grid-cols-12">
    <!-- Gallery -->
    <div class="lg:col-span-7">
      <Media src={gallery[0]} alt={`${p.name} installed`} color={p.finishes[0]?.hex} eager class="aspect-[4/3]" />
      {gallery.length > 1 && (
        <div class="mt-2 grid grid-cols-2 gap-2">
          {gallery.slice(1, 5).map((src, i) => <Media src={src} alt="" color={p.finishes[(i + 1) % p.finishes.length]?.hex} class="aspect-[4/3]" />)}
        </div>
      )}
    </div>

    <!-- Summary + finishes -->
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-24">
        <h1 class="display !text-[clamp(2.5rem,5vw,4rem)]">{p.name}</h1>
        {p.fullName !== p.name && <p class="mt-2 text-muted">{p.fullName}</p>}
        <p class="mt-4 text-lg">{p.tagline}</p>
        <dl class="num mt-6 grid grid-cols-3 border-y border-ink py-4">
          <div><dt class="text-sm text-muted">NRC</dt><dd class="mt-1 text-2xl font-semibold">{nrc != null ? nrc.toFixed(2) : 'n/a'}</dd></div>
          <div><dt class="text-sm text-muted">Fire</dt><dd class="mt-1 text-2xl font-semibold">{p.attributes.fireRating ? `Class ${p.attributes.fireRating}` : 'n/a'}</dd></div>
          <div><dt class="text-sm text-muted">Finishes</dt><dd class="mt-1 text-2xl font-semibold">{p.finishes.length}</dd></div>
        </dl>

        <div class="mt-8">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-lg">Finishes</h2>
            <p class="text-sm text-muted">Tap a finish to add a sample</p>
          </div>
          {finishGroups.map((g) => (
            <div class="mt-4">
              <p class="text-sm text-muted">{g.name}</p>
              <div class="mt-2 grid grid-cols-8 gap-1.5 sm:grid-cols-10 lg:grid-cols-8 xl:grid-cols-10">
                {g.finishes.map((f) => <FinishChip product={p.slug} name={p.name} finish={f} photo />)}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#documents" class="btn btn-primary">Specs and documents</a>
          <a href={url('/samples')} class="btn btn-line">Review sample box</a>
        </div>
      </div>
    </div>
  </div>

  <!-- About + specs -->
  <section class="wrap mt-24 grid gap-10 border-t border-ink pt-12 lg:grid-cols-12" aria-labelledby="about-h">
    <div class="lg:col-span-5">
      <h2 id="about-h" class="h2">About {p.name}</h2>
      <p class="mt-4 text-muted">{p.description}</p>
      {p.features.length > 0 && (
        <ul class="mt-6 space-y-2">
          {p.features.map((f) => <li class="flex gap-3"><span class="mt-2.5 h-px w-4 shrink-0 bg-teal" aria-hidden="true"></span><span>{f}</span></li>)}
        </ul>
      )}
      <p class="mt-6 text-sm text-muted">{material.name}{material.aka && ` (${material.aka})`} · {types.map((t) => t.name).join(', ')}</p>
    </div>
    <div class="lg:col-span-6 lg:col-start-7">
      <h3 class="text-lg">Specifications</h3>
      <dl class="mt-4 border-t border-ink">
        {specs.map(([k, v]) => (
          <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-4 border-b border-line py-3 text-sm">
            <dt class="text-muted">{k}</dt>
            <dd class="num">{Array.isArray(v) ? v.join(', ') : v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {p.designOptions.length > 0 && (
    <section class="wrap mt-20" aria-labelledby="options-h">
      <h2 id="options-h" class="text-lg">Design options</h2>
      <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-6">
        {p.designOptions.map((o) => (
          <li><Media src={o.image} alt={o.name} color="#f3f4f3" class="aspect-square [&_img]:object-contain [&_img]:p-3" /><p class="mt-2 text-sm">{o.name}</p></li>
        ))}
      </ul>
    </section>
  )}

  <!-- Documents -->
  <section id="documents" class="wrap mt-20 border-t border-ink pt-12" aria-labelledby="docs-h">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="docs-h" class="h2">Documents</h2>
      <a href={url(`/resources?product=${p.slug}`)} class="link text-sm">Open in the document library</a>
    </div>
    {sets.length ? (
      <div class="mt-8 grid gap-x-10 gap-y-10 md:grid-cols-2 xl:grid-cols-3">
        {sets.map((s) => (
          <div>
            <h3 class="text-sm font-semibold">{s.name}</h3>
            <ul class="mt-2 border-t border-line">
              {s.docs.map((d) => (
                <li class="border-b border-line">
                  <a href={d.href} target="_blank" rel="noopener" class="group flex min-h-12 items-center justify-between gap-4 py-2">
                    <span><span class="group-hover:underline">{d.title}</span><span class="block text-xs text-muted">{typeName(d.type)}{d.updated && ` · ${d.updated}`}</span></span>
                    <span class="shrink-0 rounded-sm border border-line px-1.5 text-xs font-semibold text-muted">{d.format}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ) : (
      <p class="mt-6 text-muted">No documents are published for {p.name} yet. Ask for data sheets and drawings by email.</p>
    )}
  </section>

  {used.length > 0 && (
    <section class="wrap mt-20" aria-labelledby="used-h">
      <h2 id="used-h" class="text-lg">Used in</h2>
      <ul class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {used.slice(0, 3).map((j) => (
          <li class="group relative">
            <Media src={j.images[0]} alt="" color={p.finishes[0]?.hex} class="aspect-[4/3]" />
            <p class="mt-3 font-semibold"><a href={url(`/projects/${j.slug}`)} class="after:absolute after:inset-0 group-hover:underline">{j.name}</a></p>
            <p class="text-sm text-muted">{j.sector}{j.placeholder ? ' · Sample project' : ` · ${j.location}`}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {related.length > 0 && (
    <section class="wrap mt-20" aria-labelledby="rel-h">
      <h2 id="rel-h" class="text-lg">Related products</h2>
      <ul class="mt-4 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((r) => <li><ProductCard product={r} /></li>)}
      </ul>
    </section>
  )}
</Layout>
