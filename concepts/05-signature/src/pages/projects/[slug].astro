---
import Layout from '../../layouts/Layout.astro';
import Media from '../../components/Media.astro';
import ProductCard from '../../components/ProductCard.astro';
import { projects, site, getProduct, getMaterial } from '@ml/content';
import { url } from '../../lib/utils';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const used = p.products.map(getProduct).filter(Boolean) as NonNullable<ReturnType<typeof getProduct>>[];
const color = used[0]?.finishes[0]?.hex;
const order = [...projects.filter((x) => !x.placeholder), ...projects.filter((x) => x.placeholder)];
const next = order[(order.findIndex((x) => x.slug === p.slug) + 1) % order.length];
const facts = [
  ['Sector', p.sector], ['Location', p.location], ['Year', p.year], ['Architect', p.architect], ['Size', p.size],
  ['Materials', p.materials.map((m) => getMaterial(m)?.name).join(', ')],
  ['Application', p.applications.join(', ')],
  ['Custom', p.custom ? 'Yes, adapted to the project' : null],
].filter(([, v]) => v) as [string, string][];
---
<Layout title={p.name} description={p.summary}>
  <Media src={p.images[0]} alt={p.name} color={color} eager class="h-[52svh] min-h-[18rem]" />
  <div class="wrap grid gap-10 pt-10 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <nav aria-label="Breadcrumb" class="text-sm text-muted"><a href={url('/projects')} class="hover:text-ink">Projects</a></nav>
      <h1 class="display mt-3 !text-[clamp(2.5rem,6vw,5rem)]">{p.name}</h1>
      <p class="mt-5 text-xl">{p.summary}</p>
      {p.placeholder ? (
        <p class="mt-6 border-t border-teal pt-4 text-muted">This is a sample project. The photo shows the real product; the setting is illustrative, not a completed installation.</p>
      ) : (
        <div class="mt-6 space-y-4 text-lg text-muted">{p.story.map((s) => <p>{s}</p>)}</div>
      )}
      {p.quote && <blockquote class="mt-8 text-2xl tracking-tight">“{p.quote}”</blockquote>}
    </div>
    <dl class="h-fit border-t border-ink lg:col-span-4 lg:col-start-9">
      {facts.map(([k, v]) => <div class="flex justify-between gap-4 border-b border-line py-3 text-sm"><dt class="text-muted">{k}</dt><dd class="text-right">{v}</dd></div>)}
    </dl>
  </div>

  {p.images.length > 1 && (
    <div class="wrap mt-16 grid gap-2 sm:grid-cols-2">
      {p.images.slice(1).map((src) => <Media src={src} alt="" color={color} class="aspect-[4/3]" />)}
    </div>
  )}

  <section class="wrap mt-20 border-t border-ink pt-10" aria-labelledby="used-h">
    <h2 id="used-h" class="text-2xl">{used.length ? 'Products in this project' : 'Built to the project'}</h2>
    {used.length ? (
      <ul class="mt-6 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">{used.map((u) => <li><ProductCard product={u} /></li>)}</ul>
    ) : (
      <p class="mt-3 max-w-2xl text-muted">This project used a custom {p.materials.map((m) => getMaterial(m)?.name).join(', ')} solution. To adapt a system to your own specification, email <a href={`mailto:${site.contact.email}`} class="link">{site.contact.email}</a>.</p>
    )}
  </section>

  <div class="wrap mt-20"><a href={url(`/projects/${next.slug}`)} class="group flex items-center justify-between gap-6 border-y border-ink py-8">
    <span><span class="text-sm text-muted">Next project</span><span class="mt-1 block text-2xl font-semibold tracking-tight group-hover:underline">{next.name}</span></span>
    <svg class="size-6 shrink-0 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </a></div>
</Layout>
