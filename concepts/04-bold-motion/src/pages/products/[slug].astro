---
import Layout from '../../layouts/Layout.astro';
import Media from '../../components/Media.astro';
import SampleButton from '../../components/SampleButton.astro';
import { products, getCategory, getMaterial, resourcesForProduct, resourceTypes, relatedProducts } from '@ml/content';
import { url } from '../../lib/utils';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props;
const material = getMaterial(p.material)!;
const docs = resourcesForProduct(p.slug);
const groups = resourceTypes.map((t) => ({ ...t, docs: docs.filter((d) => d.type === t.slug) })).filter((g) => g.docs.length);
const imgs = p.images.gallery.length ? p.images.gallery : [null];
const img = (i: number) => imgs[i % imgs.length];
const first = p.finishes[0];
const related = relatedProducts(p);
const chapters = [
  { id: 'story', img: img(0) },
  { id: 'why', img: img(1) },
  { id: 'specs', img: img(2) },
];
---
<Layout title={p.name} description={p.tagline}>
  <!-- Full-bleed intro -->
  <section class="relative h-svh min-h-[36rem] overflow-hidden">
    <Media src={img(0)} alt={`${p.name} installed`} class="absolute inset-0" eager imgClass="scale-105 motion-safe:animate-[zoomout_2.5s_ease-out_forwards]" />
    <div class="absolute inset-0 bg-gradient-to-t from-night via-night/40 to-night/10"></div>
    <div class="stage relative flex h-full flex-col justify-end pb-14">
      <p class="tag"><a href={url('/products')} class="hover:underline">Products</a> / {material.name} / {getCategory(p.category)?.name}</p>
      <h1 class="mega rise mt-4"><span><span>{p.name}</span></span></h1>
      <p class="reveal mt-4 max-w-2xl text-lg text-bone/85">{p.tagline}</p>
    </div>
  </section>

  <!-- Sticky image + chapters -->
  <div class="relative md:grid md:grid-cols-2">
    <div class="sticky top-0 hidden h-svh md:block" aria-hidden="true">
      {chapters.map((c, i) => <div class:list={['absolute inset-0 transition-opacity duration-700', i ? 'opacity-0' : '']} data-chapter-img={c.id}><Media src={c.img} class="h-full w-full" /></div>)}
    </div>
    <div>
      <section id="story" data-chapter="story" class="flex min-h-svh flex-col justify-center px-6 py-24 md:px-14">
        <p class="tag">The story</p>
        <p class="reveal mt-6 text-2xl leading-snug sm:text-3xl">{p.description}</p>
        <dl class="reveal mt-10 grid grid-cols-3 gap-4 border-t border-edge pt-6">
          <div><dt class="tag !text-dim">NRC</dt><dd class="mt-1 text-3xl font-bold">{p.attributes.nrc?.toFixed(2) ?? '—'}</dd></div>
          <div><dt class="tag !text-dim">Fire</dt><dd class="mt-1 text-3xl font-bold">{p.attributes.fireRating ? `Class ${p.attributes.fireRating}` : '—'}</dd></div>
          <div><dt class="tag !text-dim">Finishes</dt><dd class="mt-1 text-3xl font-bold">{p.finishes.length}</dd></div>
        </dl>
      </section>
      <section id="why" data-chapter="why" class="flex min-h-svh flex-col justify-center px-6 py-24 md:px-14">
        <p class="tag">Why it works</p>
        <ol class="mt-6 space-y-6">
          {p.features.map((f, i) => <li class="reveal flex gap-5 text-xl" style={`--i:${i}`}><span class="text-4xl font-extrabold text-sky">{i + 1}</span><span class="pt-2">{f}</span></li>)}
        </ol>
        <Media src={img(1)} class="mt-10 aspect-[4/3] rounded-3xl md:hidden" />
      </section>
      <section id="specs" data-chapter="specs" class="flex min-h-svh flex-col justify-center px-6 py-24 md:px-14">
        <p class="tag">Specifications</p>
        <dl class="mt-6 divide-y divide-edge">
          {Object.entries(p.specs).map(([k, v]) => <div class="reveal grid grid-cols-2 gap-4 py-3"><dt class="text-dim">{k}</dt><dd>{Array.isArray(v) ? v.join(', ') : v}</dd></div>)}
        </dl>
      </section>
    </div>
  </div>

  <!-- Finish wall -->
  {first && (
    <section class="border-t border-edge py-24" aria-labelledby="wall-h">
      <div class="stage grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="wall-h" class="big reveal">Finish wall</h2>
          <div class="sticky top-24 mt-8">
            <div class="aspect-square overflow-hidden rounded-3xl bg-cover bg-center transition-[background-color] duration-500" style={`background-color:${first.hex}`} data-closeup></div>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
              <div><p class="tag">Selected</p><p class="text-2xl font-bold" data-finish-name>{first.name}</p></div>
              <SampleButton product={p.slug} name={p.name} finish={first.name} label={`Add ${first.name} sample`} class="pill pill-solid" />
            </div>
          </div>
        </div>
        <div class="lg:col-span-7">
          {[...new Set(p.finishes.map((f) => f.group))].map((g) => (
            <fieldset class="mb-10">
              <legend class="tag">{g}</legend>
              <div class="mt-4 grid grid-cols-4 gap-3 sm:grid-cols-6">
                {p.finishes.filter((f) => f.group === g).map((f, i) => (
                  <label class="reveal group cursor-pointer" style={`--i:${i % 6}`} title={f.name}>
                    <input type="radio" name="finish" value={f.name} data-hex={f.hex} data-img={f.image ?? ''} checked={f === first} class="peer sr-only" />
                    <span class="block aspect-square rounded-2xl ring-offset-4 ring-offset-night transition duration-300 group-hover:scale-105 peer-checked:ring-2 peer-checked:ring-bone peer-focus-visible:outline-3 peer-focus-visible:outline-orange" style={`background:${f.hex}`}></span>
                    <span class="mt-2 block truncate text-xs text-dim">{f.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Documents -->
  <section class="stage border-t border-edge py-24" aria-labelledby="docs-h">
    <h2 id="docs-h" class="big reveal">Documents</h2>
    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {groups.map((g, i) => (
        <div class="reveal" style={`--i:${i % 4}`}>
          <p class="tag">{g.name}</p>
          <ul class="mt-3 space-y-2">{g.docs.map((d) => <li><a href={d.href} target="_blank" rel="noopener" class="group flex items-center justify-between gap-3 border-b border-edge pb-2 hover:border-bone"><span>{g.slug === 'cad' ? d.format : d.title.replace(`${p.name} `, '')}</span><span class="text-dim transition group-hover:translate-x-1" aria-hidden="true">↗</span></a></li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  {related.length > 0 && (
    <section class="stage pb-24" aria-labelledby="rel-h">
      <h2 id="rel-h" class="tag">Next</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {related.map((r, i) => (
          <a href={url(`/products/${r.slug}`)} class="reveal group relative block overflow-hidden rounded-3xl" style={`--i:${i}`}>
            <Media src={r.images.hero} class="aspect-[4/3]" imgClass="transition duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-night/90 to-transparent"></div>
            <p class="absolute bottom-0 p-6 text-3xl font-extrabold uppercase tracking-tighter">{r.name}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <style is:global>
    @keyframes zoomout { to { transform: scale(1); } }
  </style>
  <script>
    // Crossfade the sticky image to match the chapter in view.
    const imgs = document.querySelectorAll<HTMLElement>('[data-chapter-img]');
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const id = (e.target as HTMLElement).dataset.chapter;
      imgs.forEach((im) => im.classList.toggle('opacity-0', im.dataset.chapterImg !== id));
    }), { threshold: 0.5 });
    document.querySelectorAll('[data-chapter]').forEach((c) => io.observe(c));

    // Finish wall: selecting a swatch fills the close-up with its texture.
    const close = document.querySelector<HTMLElement>('[data-closeup]');
    const btn = document.querySelector<HTMLButtonElement>('[data-closeup] ~ div [data-add-sample]');
    const show = (i: HTMLInputElement) => {
      if (!close) return;
      close.style.backgroundColor = i.dataset.hex!;
      close.style.backgroundImage = i.dataset.img ? `url("${i.dataset.img}")` : '';
    };
    document.querySelectorAll<HTMLInputElement>('input[name=finish]').forEach((i) => i.addEventListener('change', () => {
      show(i);
      document.querySelector('[data-finish-name]')!.textContent = i.value;
      if (btn) { btn.dataset.finish = i.value; btn.dataset.labelAdd = `Add ${i.value} sample`; }
      window.dispatchEvent(new CustomEvent('ml:cart'));
    }));
    const checked = document.querySelector<HTMLInputElement>('input[name=finish]:checked');
    if (checked) show(checked);
  </script>
</Layout>
