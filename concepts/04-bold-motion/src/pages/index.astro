---
import Layout from '../layouts/Layout.astro';
import Media from '../components/Media.astro';
import { site, materials, products, projects, productsInMaterial, getProduct, getMaterial } from '@ml/content';
import { url } from '../lib/utils';

const bandProducts = ['silk-metal-baffles', 'pet-felt-ceiling-tiles-coffa', 'wood-slat-panels-slatta'].map((s) => getProduct(s)!);
const bands = [
  { p: bandProducts[0], left: '0%', clip: '0 100%, 58% 100%, 100% 0, 42% 0', from: '110%', dx: '-6vw' },
  { p: bandProducts[1], left: '30%', clip: '0 0, 58% 0, 100% 100%, 42% 100%', from: '-110%', dx: '0vw' },
  { p: bandProducts[2], left: '60%', clip: '0 0, 58% 0, 100% 100%, 42% 100%', from: '110%', dx: '6vw' },
];
const lines = ['Where', 'fabrication', 'meets', 'imagination.'];
const names = products.map((p) => p.name).filter((n) => n.length < 12);
const featured = products.filter((p) => p.featured);
const showcase = projects.filter((p) => !p.placeholder);
---
<Layout>
  <!-- Hero -->
  <section class="relative h-svh min-h-[40rem] overflow-hidden" aria-labelledby="hero-h">
    <div class="absolute inset-y-0 right-[-10%] w-[110%] sm:right-0 sm:w-[70%]" aria-hidden="true">
      {bands.map((b, i) => (
        <div class="drift absolute inset-y-0 w-[42%]" style={`left:${b.left}; --dx:${b.dx}`}>
          <div class="band h-full w-full" style={`--i:${i}; --from:${b.from}; clip-path: polygon(${b.clip})`}>
            <Media src={b.p.images.hero} class="h-full w-full" eager imgClass="opacity-80" />
          </div>
        </div>
      ))}
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-night via-night/70 to-transparent sm:via-night/40"></div>
    <div class="stage relative flex h-full flex-col justify-end pb-16">
      <p class="tag">Acoustical &amp; architectural products · 40 years</p>
      <h1 id="hero-h" class="mega rise mt-6">
        {lines.map((l, i) => <span class:list={[i === 3 && 'pb-[0.14em]']}><span style={`--i:${i}`} class:list={[i === 3 && 'underline-o']}>{l}</span></span>)}
      </h1>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href={url('/products')} class="pill pill-solid">Explore products</a>
        <a href="#materials" class="pill">Scroll to explore ↓</a>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="overflow-hidden border-y border-edge py-6" aria-hidden="true">
    <div class="marquee gap-12 whitespace-nowrap text-5xl font-extrabold uppercase tracking-tighter text-transparent [-webkit-text-stroke:1px_var(--color-dim)] sm:text-7xl">
      {[...names, ...names].map((n) => <span class="px-6">{n}</span>)}
    </div>
  </div>

  <!-- Statement -->
  <section class="stage py-32">
    <p class="reveal max-w-5xl text-[clamp(1.75rem,4vw,3.5rem)] font-semibold leading-[1.1] tracking-tight">{site.intro}</p>
    <div class="mt-16 grid gap-8 sm:grid-cols-3">
      {site.values.map((v, i) => <div class="reveal border-t border-edge pt-6" style={`--i:${i}`}><h2 class="text-2xl uppercase">{v.title}</h2><p class="mt-3 text-dim">{v.text}</p></div>)}
    </div>
  </section>

  <!-- Pinned horizontal materials -->
  <section id="materials" class="relative" data-pin aria-label="Materials">
    <div class="sticky top-0 flex h-svh flex-col justify-center overflow-hidden" data-pin-viewport>
      <p class="stage tag">Four materials</p>
      <div class="mt-6 flex gap-6 overflow-x-auto px-4 pb-4 md:px-10" data-track>
        {materials.map((m, i) => {
          const items = productsInMaterial(m.slug);
          return (
            <a href={url(`/products?material=${m.slug}`)} class="group relative h-[65svh] w-[85vw] shrink-0 overflow-hidden rounded-3xl sm:w-[60vw] lg:w-[45vw]">
              <Media src={items[0]?.images.gallery[1] ?? items[0]?.images.hero} class="absolute inset-0" imgClass="transition duration-700 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-night via-night/30 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-6 sm:p-10">
                <p class="tag">0{i + 1} / 0{materials.length}</p>
                <h2 class="big mt-3">{m.name}</h2>
                <p class="mt-2 text-dim">{m.aka ?? `${items.length} products`}{m.aka && ` · ${items.length} products`}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Featured -->
  <section class="stage py-32" aria-labelledby="feat-h">
    <h2 id="feat-h" class="big reveal">Featured</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {featured.map((p, i) => (
        <a href={url(`/products/${p.slug}`)} class="reveal group relative block overflow-hidden rounded-3xl" style={`--i:${i % 2}`}>
          <Media src={p.images.hero} class="aspect-[4/3]" imgClass="transition duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-night/90 to-transparent opacity-80 transition group-hover:opacity-100"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-6">
            <div><p class="tag">{getMaterial(p.material)?.name}</p><p class="mt-2 text-4xl font-extrabold uppercase tracking-tighter">{p.name}</p></div>
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-bone text-night transition group-hover:rotate-[-45deg]" aria-hidden="true">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Process -->
  <section class="bg-green py-32" aria-labelledby="proc-h">
    <div class="stage">
      <p class="tag text-bone">{site.materialize.title}</p>
      <h2 id="proc-h" class="big reveal mt-4">Ideate.<br />Co-create.<br />Fabricate.</h2>
      <ol class="mt-16 grid gap-px overflow-hidden rounded-3xl bg-bone/20 sm:grid-cols-5">
        {site.process.map((s, i) => (
          <li class="reveal bg-green p-6" style={`--i:${i}`}>
            <p class="text-7xl font-extrabold text-sky">{i + 1}</p>
            <h3 class="mt-6 text-2xl uppercase">{s.step}</h3>
            <p class="mt-2 text-bone/80">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Projects -->
  <section class="stage py-32" aria-labelledby="proj-h">
    <div class="flex items-end justify-between gap-4">
      <h2 id="proj-h" class="big reveal">Built</h2>
      <a href={url('/projects')} class="pill">All projects →</a>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-12">
      {showcase.map((p, i) => (
        <a href={url(`/projects/${p.slug}`)} class:list={['reveal group block', i === 0 ? 'md:col-span-7' : 'md:col-span-5 md:mt-32']} style={`--i:${i}`}>
          <Media src={p.images[0]} class="aspect-[4/5] rounded-3xl" imgClass="transition duration-700 group-hover:scale-105" />
          <p class="tag mt-4">{p.sector} · {p.location}</p>
          <p class="mt-2 text-3xl font-bold uppercase tracking-tighter">{p.name}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Samples -->
  <section class="stage pb-16">
    <a href={url('/samples')} class="reveal group block overflow-hidden rounded-3xl bg-bone p-10 text-night sm:p-16">
      <p class="tag !text-green">Samples</p>
      <p class="big mt-4">Feel it first →</p>
      <p class="mt-4 max-w-xl text-lg">Pick up to {site.sampleLimit} colors and finishes. They ship within a day, with data sheets.</p>
    </a>
  </section>

  <script>
    // Pinned horizontal scroll: the section is tall, the viewport sticks, and the track
    // translates with scroll progress. Reduced motion keeps a normal swipeable row.
    const pin = document.querySelector<HTMLElement>('[data-pin]')!;
    const track = pin.querySelector<HTMLElement>('[data-track]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    function setup() {
      if (reduce.matches) { pin.style.height = ''; track.style.transform = ''; track.style.overflowX = 'auto'; return; }
      track.style.overflowX = 'visible';
      const distance = track.scrollWidth - innerWidth;
      pin.style.height = `${innerHeight + Math.max(0, distance)}px`;
    }
    function onScroll() {
      if (reduce.matches) return;
      const r = pin.getBoundingClientRect();
      const total = pin.offsetHeight - innerHeight;
      const progress = Math.min(1, Math.max(0, -r.top / (total || 1)));
      track.style.transform = `translate3d(${-progress * (track.scrollWidth - innerWidth)}px,0,0)`;
    }
    setup(); onScroll();
    addEventListener('resize', () => { setup(); onScroll(); });
    addEventListener('scroll', () => requestAnimationFrame(onScroll), { passive: true });
    reduce.addEventListener('change', () => { setup(); onScroll(); });
  </script>
</Layout>
