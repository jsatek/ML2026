---
import Layout from '../layouts/Layout.astro';
import Media from '../components/Media.astro';
import SampleButton from '../components/SampleButton.astro';
import { site, materials, products, projects, productsInMaterial, getProduct, getMaterial, specSummary, formatNrc, finishWall } from '@ml/content';
import { url } from '../lib/utils';

const bandProducts = ['silk-metal-baffles', 'pet-felt-ceiling-tiles-coffa', 'wood-slat-panels-slatta'].map((s) => getProduct(s)!);
const bands = [
  { p: bandProducts[0], left: '0%', clip: '0 100%, 58% 100%, 100% 0, 42% 0', from: '110%', dx: '-6vw' },
  { p: bandProducts[1], left: '30%', clip: '0 0, 58% 0, 100% 100%, 42% 100%', from: '-110%', dx: '0vw' },
  { p: bandProducts[2], left: '60%', clip: '0 0, 58% 0, 100% 100%, 42% 100%', from: '110%', dx: '6vw' },
];
const lines = ['Where', 'fabrication', 'meets', 'imagination.'];
const wall = finishWall();
const wallTotal = wall.reduce((n, w) => n + w.count, 0);
const wallProducts = Object.fromEntries(products.map((p) => [p.slug, { name: p.name, href: url(`/products/${p.slug}`) }]));
const showcase = projects.filter((p) => !p.placeholder);
const silk = getMaterial('silk-metal')!;
const silkProducts = productsInMaterial(silk.slug);
const silkSpec = specSummary(silkProducts);
const silkSentences = silk.summary.match(/[^.!?]+[.!?]+/g) ?? [];
const silkAt = silkSentences.findIndex((t) => t.includes('perforations'));
const silkCopy = silkAt >= 0 ? silkSentences.slice(silkAt, silkAt + 2).join(' ').trim() : silk.aka;
const silkHero = silkProducts.find((p) => p.slug === 'silk-metal-grille') ?? silkProducts[0];
---
<Layout>
  <!-- Hero -->
  <section class="relative h-svh min-h-[40rem] overflow-hidden" aria-labelledby="hero-h">
    <div class="absolute inset-y-0 right-[-10%] w-[110%] sm:right-0 sm:w-[70%]" aria-hidden="true">
      {bands.map((b, i) => (
        <div class="drift absolute inset-y-0 w-[42%]" style={`left:${b.left}; --dx:${b.dx}`}>
          <div class="band h-full w-full" style={`--i:${i}; --from:${b.from}; clip-path: polygon(${b.clip})`}>
            <Media src={b.p.images.hero} class="h-full w-full" eager imgClass="opacity-80" />
          </div>
        </div>
      ))}
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-night via-night/70 to-transparent sm:via-night/40"></div>
    <div class="stage relative flex h-full flex-col justify-end pb-16">
      <h1 id="hero-h" class="mega rise">
        {lines.map((l, i) => <span class:list={[i === 3 && 'pb-[0.14em]']}><span class:list={[i === 3 && 'underline-o']}>{l}</span></span>)}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-dim">Acoustical and architectural products in {new Intl.ListFormat('en', { type: 'conjunction' }).format(materials.map((m) => m.name))}.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={url('/products')} class="pill pill-solid">Explore products</a>
        <a href={url('/samples')} class="pill">Order samples</a>
      </div>
    </div>
  </section>

  <!-- Statement -->
  <section class="stage py-32">
    <p class="max-w-5xl text-[clamp(1.75rem,4vw,3.5rem)] font-semibold leading-[1.1] tracking-tight">{site.intro}</p>
  </section>

  <!-- Pinned horizontal materials -->
  <section id="materials" class="relative" data-pin aria-label="Materials">
    <div class="sticky top-0 flex h-svh flex-col justify-center overflow-hidden" data-pin-viewport>
      <h2 class="stage text-3xl font-bold uppercase tracking-tight">Four materials</h2>
      <div class="mt-6 flex gap-6 overflow-x-auto px-4 pb-4 md:px-10" data-track>
        {materials.map((m) => {
          const items = productsInMaterial(m.slug);
          const spec = specSummary(items);
          return (
            <a href={url(`/products?material=${m.slug}`)} class="group relative h-[65svh] w-[85vw] shrink-0 overflow-hidden rounded-3xl sm:w-[60vw] lg:w-[45vw]">
              <Media src={items[0]?.images.gallery[1] ?? items[0]?.images.hero} class="absolute inset-0" imgClass="transition duration-700 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-night via-night/30 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-6 sm:p-10">
                <h3 class="big">{m.name}</h3>
                {m.aka && <p class="mt-2 text-dim">{m.aka}</p>}
                <p class="mt-2 tabular-nums">{items.length} products{formatNrc(spec) && ` · NRC ${formatNrc(spec)}`}{spec.fire.length > 0 && ` · Class ${spec.fire.join('/')}`} · {spec.finishes.length} finishes</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Silk Metal -->
  <section class="stage grid gap-12 py-32 lg:grid-cols-12" aria-labelledby="silk-h">
    <div class="lg:col-span-5">
      <h2 id="silk-h" class="big">{silk.name}</h2>
      <p class="mt-3 text-xl text-sky">{silk.aka}</p>
      <p class="mt-8 text-lg text-dim">{silkCopy}</p>
      <dl class="mt-10 grid grid-cols-3 gap-6 border-t border-edge pt-6">
        <div><dt class="text-sm text-dim">NRC</dt><dd class="mt-1 text-3xl font-bold tabular-nums">{formatNrc(silkSpec) ?? '–'}</dd></div>
        <div><dt class="text-sm text-dim">Fire</dt><dd class="mt-1 text-3xl font-bold">{silkSpec.fire.map((r) => `Class ${r}`).join(', ') || '–'}</dd></div>
        <div><dt class="text-sm text-dim">Finishes</dt><dd class="mt-1 text-3xl font-bold tabular-nums">{silkSpec.finishes.length}</dd></div>
      </dl>
      <a href={url(`/products?material=${silk.slug}`)} class="pill pill-solid mt-10">See {silkSpec.count} {silk.name} systems</a>
    </div>
    <div class="lg:col-span-7">
      <Media src={silkHero.images.hero} color={silkSpec.finishes[0]?.hex} class="aspect-[4/3] rounded-3xl" />
      <ul class="mt-6 grid grid-cols-7 gap-2 sm:grid-cols-[repeat(21,minmax(0,1fr))]" aria-label={`${silk.name} finishes`}>
        {silkSpec.finishes.map((f) => <li class="aspect-[1/2] rounded-full" style={`background:${f.hex}`} title={f.name}><span class="sr-only">{f.name}</span></li>)}
      </ul>
      <p class="mt-3 text-sm text-dim">{silkSpec.finishGroups.join(' · ')}</p>
    </div>
  </section>

  <!-- Finish wall -->
  <section class="stage py-32" aria-labelledby="wall-h" data-finish-wall>
    <h2 id="wall-h" class="big">Every finish</h2>
    <p class="mt-4 max-w-2xl text-lg text-dim">{wallTotal} finishes across {wall.length} materials, shown as true color. Pick one to see the products that come in it and add a sample.</p>
    <script type="application/json" data-wall-products set:html={JSON.stringify(wallProducts)}></script>
    <div class="mt-16 grid gap-12 lg:grid-cols-12">
      <div class="space-y-14 lg:col-span-8">
        {wall.map((w) => (
          <div>
            <div class="flex items-baseline justify-between gap-4 border-b border-edge pb-3">
              <h3 class="text-3xl font-extrabold uppercase tracking-tight">{w.material.name}</h3>
              <a href={url(`/products?material=${w.material.slug}`)} class="text-sm text-dim hover:text-bone">{w.count} finishes</a>
            </div>
            {w.groups.map((g) => (
              <div class="mt-5">
                <p class="text-sm text-dim">{g.name}</p>
                <ul class="mt-2 grid grid-cols-[repeat(auto-fill,minmax(2rem,1fr))] gap-1.5">
                  {g.finishes.map((f) => (
                    <li>
                      <a href={url(`/products/${f.products[0]}`)} class="swatch block aspect-[1/2] rounded-full ring-1 ring-white/10 ring-inset" style={`background:${f.hex}`} title={f.name}
                        data-swatch data-name={f.name} data-hex={f.hex} data-image={f.image ?? ''} data-group={g.name} data-material={w.material.name} data-products={f.products.join(' ')}
                      ><span class="sr-only">{f.name}, {w.material.name}</span></a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ))}
      </div>
      <div class="lg:col-span-4">
        <div data-wall-panel hidden aria-live="polite" class="fixed inset-x-0 bottom-0 z-40 max-h-[70svh] overflow-y-auto rounded-t-3xl border-t border-edge bg-night-2 p-6 lg:sticky lg:top-28 lg:z-auto lg:max-h-[calc(100svh-8rem)] lg:rounded-3xl lg:border">
          <div class="flex items-start justify-between gap-4">
            <div data-wall-chip class="aspect-[3/4] w-28 shrink-0 rounded-2xl bg-cover bg-center sm:w-36"></div>
            <button type="button" data-wall-close class="pill !p-2" aria-label="Close finish details">
              <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
            </button>
          </div>
          <p data-wall-name class="mt-5 text-3xl font-extrabold uppercase tracking-tight"></p>
          <p data-wall-meta class="mt-1 text-dim"></p>
          <p data-wall-count class="mt-1 text-sm text-sky"></p>
          <ul data-wall-rows class="mt-5 divide-y divide-edge border-t border-edge"></ul>
          <template data-wall-row>
            <li class="flex items-center justify-between gap-3 py-3">
              <a data-row-link data-row-name class="font-bold uppercase hover:text-sky"></a>
              <SampleButton product="" name="" finish="" label="Sample" class="pill shrink-0 whitespace-nowrap !py-1.5 text-sm" />
            </li>
          </template>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-green py-32" aria-labelledby="proc-h">
    <div class="stage">
      <h2 id="proc-h" class="big">{site.materialize.title}</h2>
      <p class="mt-6 max-w-3xl text-xl text-bone/85">{site.materialize.text}</p>
      <ol class="mt-16 grid gap-x-8 border-t border-bone/30 sm:grid-cols-5">
        {site.process.map((s, i) => (
          <li class="border-b border-bone/20 py-6 sm:border-b-0">
            <h3 class="text-2xl uppercase"><span class="mr-2 text-base font-semibold tabular-nums text-sky">{i + 1}</span>{s.step}</h3>
            <p class="mt-2 text-bone/80">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Projects -->
  <section class="stage py-32" aria-labelledby="proj-h">
    <div class="flex items-end justify-between gap-4">
      <h2 id="proj-h" class="big">Projects</h2>
      <a href={url('/projects')} class="pill">All projects →</a>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-12">
      {showcase.map((p, i) => (
        <a href={url(`/projects/${p.slug}`)} class:list={['group block', i === 0 ? 'md:col-span-7' : 'md:col-span-5 md:mt-32']}>
          <Media src={p.images[0]} class="aspect-[4/5] rounded-3xl" imgClass="transition duration-700 group-hover:scale-105" />
          <p class="mt-4 text-3xl font-bold uppercase tracking-tighter">{p.name}</p>
          <p class="mt-1 text-dim">{p.sector} · {p.location}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Samples -->
  <section class="stage border-t border-edge py-24" aria-labelledby="samples-h">
    <h2 id="samples-h" class="big">Feel it first</h2>
    <p class="mt-4 max-w-xl text-lg text-dim">Pick up to {site.sampleLimit} colors and finishes from any product.</p>
    <a href={url('/samples')} class="pill pill-solid mt-8">Start a sample request</a>
  </section>

  <script>
    import { bindFinishWall } from '@ml/content/finish-wall';
    bindFinishWall();

    // Pinned horizontal scroll: the section is tall, the viewport sticks, and the track
    // translates with scroll progress. Reduced motion keeps a normal swipeable row.
    const pin = document.querySelector<HTMLElement>('[data-pin]')!;
    const track = pin.querySelector<HTMLElement>('[data-track]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    function setup() {
      if (reduce.matches) { pin.style.height = ''; track.style.transform = ''; track.style.overflowX = 'auto'; return; }
      track.style.overflowX = 'visible';
      const distance = track.scrollWidth - innerWidth;
      pin.style.height = `${innerHeight + Math.max(0, distance)}px`;
    }
    function onScroll() {
      if (reduce.matches) return;
      const r = pin.getBoundingClientRect();
      const total = pin.offsetHeight - innerHeight;
      const progress = Math.min(1, Math.max(0, -r.top / (total || 1)));
      track.style.transform = `translate3d(${-progress * (track.scrollWidth - innerWidth)}px,0,0)`;
    }
    setup(); onScroll();
    addEventListener('resize', () => { setup(); onScroll(); });
    addEventListener('scroll', () => requestAnimationFrame(onScroll), { passive: true });
    reduce.addEventListener('change', () => { setup(); onScroll(); });
  </script>
</Layout>
