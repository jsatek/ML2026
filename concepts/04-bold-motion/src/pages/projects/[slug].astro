---
import Layout from '../../layouts/Layout.astro';
import Media from '../../components/Media.astro';
import SampleButton from '../../components/SampleButton.astro';
import { projects, site, getProduct, getMaterial } from '@ml/content';
import { url } from '../../lib/utils';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project: p } = Astro.props;
const used = p.products.map((s) => getProduct(s)!).filter(Boolean);
const facts = [['Market', p.sector], ['Location', p.location], ['Year', p.year], ['Material', p.materials.map((m) => getMaterial(m)?.name).join(', ')], ['Application', p.applications.join(', ')]].filter(([, v]) => v);
const next = projects[(projects.indexOf(p) + 1) % projects.length];
---
<Layout title={p.name} description={p.summary}>
  <section class="relative h-svh min-h-[36rem] overflow-hidden">
    <Media src={p.images[0]} alt={p.name} class="absolute inset-0" eager />
    <div class="absolute inset-0 bg-gradient-to-t from-night via-night/40 to-transparent"></div>
    <div class="stage relative flex h-full flex-col justify-end pb-14">
      <p class="tag"><a href={url('/projects')} class="hover:underline">Projects</a> / {p.sector}{p.placeholder && ' / Sample project'}</p>
      <h1 class="mega rise mt-4"><span><span>{p.name}</span></span></h1>
    </div>
  </section>

  <section class="stage grid gap-12 py-24 lg:grid-cols-12">
    <dl class="reveal h-fit divide-y divide-edge border-y border-edge lg:col-span-4">
      {facts.map(([k, v]) => <div class="flex justify-between gap-4 py-3"><dt class="text-dim">{k}</dt><dd class="text-right font-semibold">{v}</dd></div>)}
    </dl>
    <div class="space-y-8 lg:col-span-8">
      <p class="reveal text-[clamp(1.5rem,3vw,2.5rem)] font-semibold leading-tight tracking-tight">{p.summary}</p>
      {p.story.map((s) => <p class="reveal text-xl text-dim">{s}</p>)}
      {p.placeholder && <p class="reveal rounded-2xl border border-orange/60 p-4 text-sm">This is a sample project: a real product photo with an invented story.</p>}
    </div>
  </section>

  {p.images.length > 1 && (
    <section class="stage grid gap-6 pb-24 md:grid-cols-2">{p.images.slice(1, 3).map((src, i) => <Media src={src} class="reveal aspect-[4/3] rounded-3xl" />)}</section>
  )}

  <section class="border-t border-edge py-24">
    <div class="stage">
      {used.length ? (
        <>
          <h2 class="big reveal">Specified</h2>
          <ul class="mt-10 grid gap-6 md:grid-cols-3">
            {used.map((u, i) => (
              <li class="reveal overflow-hidden rounded-3xl border border-edge" style={`--i:${i}`}>
                <a href={url(`/products/${u.slug}`)} class="group block" tabindex="-1" aria-hidden="true"><Media src={u.images.hero} class="aspect-[4/3]" imgClass="transition duration-700 group-hover:scale-105" /></a>
                <div class="flex items-center justify-between gap-3 p-5">
                  <a href={url(`/products/${u.slug}`)} class="text-2xl font-extrabold uppercase tracking-tighter hover:text-sky">{u.name}</a>
                  {u.finishes[0] && <SampleButton product={u.slug} name={u.name} finish={u.finishes[0].name} label="Sample" class="pill !py-1.5 text-sm" />}
                </div>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <div class="reveal grid gap-8 md:grid-cols-2">
          <h2 class="big">Made with {site.materialize.title}</h2>
          <div><p class="text-xl text-dim">{site.materialize.text}</p><a href={`mailto:${site.contact.email}`} class="pill pill-solid mt-6">Start your project →</a></div>
        </div>
      )}
    </div>
  </section>

  <a href={url(`/projects/${next.slug}`)} class="group relative block h-[50svh] overflow-hidden">
    <Media src={next.images[0]} class="absolute inset-0" imgClass="opacity-50 transition duration-700 group-hover:scale-105 group-hover:opacity-70" />
    <div class="stage relative flex h-full flex-col justify-center"><p class="tag">Next project</p><p class="big mt-3">{next.name} →</p></div>
  </a>
</Layout>
