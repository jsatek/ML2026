---
// Real photo when available, otherwise a flat color field.
interface Props { src?: string | null; alt?: string; color?: string; class?: string; eager?: boolean; fit?: 'cover' | 'contain'; }
const { src, alt = '', color = '#d9d5cb', class: cls = '', eager = false, fit = 'cover' } = Astro.props;
---
<div class:list={['relative overflow-hidden', cls]} style={`background:${color}`}>
  {src && <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" class:list={['absolute inset-0 h-full w-full', fit === 'cover' ? 'object-cover' : 'object-contain p-4']} />}
</div>
